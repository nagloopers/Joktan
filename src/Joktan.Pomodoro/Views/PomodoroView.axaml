<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Pomodoro.Resources"
             xmlns:vm="using:Joktan.Pomodoro.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="736"
             x:Class="Joktan.Pomodoro.Views.PomodoroView"
             x:DataType="vm:PomodoroViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">
                <Border Classes="card">
                    <StackPanel HorizontalAlignment="Center" Width="360" Spacing="12">
                        <TextBlock Classes="card-title" HorizontalAlignment="Center" Text="{Binding PhaseName}" />
                        <TextBlock Name="RemainingText" Classes="tile-value" FontSize="72" HorizontalAlignment="Center" Text="{Binding RemainingText}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Button Name="StartPauseButton" Classes="accent" Content="{Binding StartPauseText}" Command="{Binding StartPauseCommand}" />
                            <Button Content="{x:Static res:Strings.PomodoroView_Reset}" Command="{Binding ResetCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.PomodoroView_StopAndGoBackToThe}" />
                            <Button Content="{x:Static res:Strings.PomodoroView_Skip}" Command="{Binding SkipCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.PomodoroView_MoveOnToTheNextPhase}" />
                        </StackPanel>
                        <TextBlock Classes="info-label" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding Message}"
                                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="info-label" HorizontalAlignment="Center" Text="{Binding DoneTodayText}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.PomodoroView_Settings}" />
                        <TextBlock Classes="card-subtitle"
                                   Text="{x:Static res:Strings.PomodoroView_ANewLengthAppliesFromThe}" />

                        <Border Classes="table-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="table-cell" Text="{x:Static res:Strings.PomodoroView_FocusInMinutes}" />
                                <NumericUpDown Grid.Column="1" Value="{Binding FocusMinutes}" Minimum="1" Maximum="180" Increment="5" FormatString="0" Width="120" />
                            </Grid>
                        </Border>
                        <Border Classes="table-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="table-cell" Text="{x:Static res:Strings.PomodoroView_ShortBreakInMinutes}" />
                                <NumericUpDown Grid.Column="1" Value="{Binding ShortBreakMinutes}" Minimum="1" Maximum="180" Increment="1" FormatString="0" Width="120" />
                            </Grid>
                        </Border>
                        <Border Classes="table-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="table-cell" Text="{x:Static res:Strings.PomodoroView_LongBreakInMinutes}" />
                                <NumericUpDown Grid.Column="1" Value="{Binding LongBreakMinutes}" Minimum="1" Maximum="180" Increment="5" FormatString="0" Width="120" />
                            </Grid>
                        </Border>
                        <Border Classes="table-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="table-cell" Text="{x:Static res:Strings.PomodoroView_FocusPeriodsBeforeALongBreak}" />
                                <NumericUpDown Grid.Column="1" Value="{Binding FocusesBeforeLongBreak}" Minimum="1" Maximum="12" Increment="1" FormatString="0" Width="120" />
                            </Grid>
                        </Border>
                        <Border Classes="table-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="table-cell" Text="{x:Static res:Strings.PomodoroView_StartTheNextPhaseByItself}" />
                                <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding AutoStart}"
                                              ToolTip.Tip="{x:Static res:Strings.PomodoroView_WhenAPhaseEndsTheNext}" />
                            </Grid>
                        </Border>
                        <Border Classes="table-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="table-cell" Text="{x:Static res:Strings.PomodoroView_AddAnAlertWhenAPhase}" />
                                <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding AlertAtEnd}"
                                              ToolTip.Tip="{x:Static res:Strings.PomodoroView_ShowsUnderTheBellInThe}" />
                            </Grid>
                        </Border>
                        <Border Classes="table-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="table-cell" Text="{x:Static res:Strings.PomodoroView_SayItAloudWhenAPhase}" />
                                <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding SpeakAtEnd}"
                                              ToolTip.Tip="{x:Static res:Strings.PomodoroView_HeardEvenWhileJoktanIsBehind}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
