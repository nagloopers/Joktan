<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Joktan.TopicExplorer.Resources"
        xmlns:vm="using:Joktan.TopicExplorer.ViewModels"
        xmlns:views="using:Joktan.TopicExplorer.Views"
        xmlns:core="using:Joktan.Core"
        xmlns:controls="using:Joktan.Core.Controls"
        x:Class="Joktan.TopicExplorer.Views.TopicExplorerWindow"
        core:HelpContext.Topic="topic-explorer"
        x:DataType="vm:TopicExplorerViewModel"
        Icon="avares://Joktan.Core/Assets/joktan.ico"
        Width="1100" Height="760"
        MinWidth="760" MinHeight="480"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Title="{x:Static res:Strings.TopicExplorerWindow_TopicExplorerJoktan}">

    <DockPanel>
        <!-- The window's title bar, as in the main window: drag it to move the window, double-click to maximise -->
        <Border DockPanel.Dock="Top"
                Classes="topbar"
                Height="{StaticResource TopBarHeight}"
                PointerPressed="OnTopBarPointerPressed">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Text="{x:Static res:Strings.TopicExplorerWindow_TopicExplorer}" />

                <controls:HelpButton Grid.Column="1" VerticalAlignment="Center" />

                <!-- Window controls, in place of the system title bar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="20,0,0,0">
                    <Button Classes="window-button" ToolTip.Tip="{x:Static res:Strings.TopicExplorerWindow_Minimise}" Click="OnMinimizeClick">
                        <PathIcon Data="{x:Static core:Icons.WindowMinimize}" />
                    </Button>
                    <Button Classes="window-button" ToolTip.Tip="{x:Static res:Strings.TopicExplorerWindow_Maximise}" Name="MaximizeButton" Click="OnMaximizeClick">
                        <PathIcon Name="MaximizeIcon" Data="{x:Static core:Icons.WindowMaximize}" />
                    </Button>
                    <Button Classes="window-button close" ToolTip.Tip="{x:Static res:Strings.TopicExplorerWindow_Close}" Click="OnCloseClick">
                        <PathIcon Data="{x:Static core:Icons.WindowClose}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <views:TopicExplorerPanel />
    </DockPanel>

</Window>
