<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.TopicExplorer.Resources"
             xmlns:vm="using:Joktan.TopicExplorer.ViewModels"
             xmlns:views="using:Joktan.TopicExplorer.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="736"
             x:Class="Joktan.TopicExplorer.Views.TopicExplorerView"
             x:DataType="vm:TopicExplorerViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <Panel>
            <!-- Shown here unless the explorer has been moved to its own window -->
            <ContentControl IsVisible="{Binding ShowPage}">
                <views:TopicExplorerPanel />
            </ContentControl>

            <Border Classes="card" Margin="24" VerticalAlignment="Top" IsVisible="{Binding IsPoppedOut}">
                <StackPanel Spacing="12">
                    <TextBlock Classes="card-title" Text="{x:Static res:Strings.TopicExplorerView_TheTopicExplorerIsOpenIn}" />
                    <TextBlock Classes="card-subtitle" Text="{x:Static res:Strings.TopicExplorerView_ItKeepsRunningWhileYouUse}" />
                    <Button Content="{x:Static res:Strings.TopicExplorerView_BackToMainWindow}" Command="{Binding DockCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Panel>
    </DockPanel>

</UserControl>
