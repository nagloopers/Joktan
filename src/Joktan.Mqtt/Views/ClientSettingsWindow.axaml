<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Joktan.Mqtt.Resources"
        xmlns:help="using:Joktan.Core.Controls"
        xmlns:c="using:Joktan.Mqtt.Controls"
        xmlns:core="using:Joktan.Core"
        xmlns:vm="using:Joktan.Mqtt.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="760"
        x:Class="Joktan.Mqtt.Views.ClientSettingsWindow"
        core:HelpContext.Topic="mqtt-clients"
        x:DataType="vm:ClientSettingsViewModel"
        Width="680" Height="760"
        MinWidth="560" MinHeight="440"
        Icon="avares://Joktan.Core/Assets/joktan.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="{x:Static res:Strings.ClientSettingsWindow_MQTTClient}"
        x:Name="Root">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" FontSize="{DynamicResource DialogTitleFontSize}" Text="{x:Static res:Strings.ClientSettingsWindow_MQTTClient}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Title}" />
                </StackPanel>
                <help:HelpButton Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="topbar" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="error"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,16,0"
                           Text="{Binding Error}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static res:Strings.ClientSettingsWindow_Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Classes="accent" Content="{x:Static res:Strings.ClientSettingsWindow_Save}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">

                <!-- Broker -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.ClientSettingsWindow_Broker}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_Name}" />
                                <TextBox Text="{Binding Name}" PlaceholderText="{x:Static res:Strings.ClientSettingsWindow_PlantAShownOnTheClient}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_ClientID}" />
                                <TextBox Text="{Binding ClientId}" PlaceholderText="{x:Static res:Strings.ClientSettingsWindow_EmptyToMakeOneUp}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,100" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_Host}" />
                                <TextBox Text="{Binding Host}" PlaceholderText="{x:Static res:Strings.ClientSettingsWindow_IPAddressOrHostName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_Port}" />
                                <TextBox Text="{Binding Port}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_UsernameOptional}" />
                                <TextBox Text="{Binding Username}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_PasswordOptional}" />
                                <TextBox Text="{Binding Password}" PasswordChar="•" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- TLS -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Classes="card-title" Text="{x:Static res:Strings.ClientSettingsWindow_TLS}" />
                            <TextBlock Classes="card-subtitle"
                                       Text="{x:Static res:Strings.ClientSettingsWindow_EncryptsTheConnectionAndChecksThe}" />
                        </StackPanel>

                        <CheckBox Content="{x:Static res:Strings.ClientSettingsWindow_UseTLS}" IsChecked="{Binding UseTls}" />

                        <StackPanel Spacing="12" IsVisible="{Binding UseTls}">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_CACertificateOptional}" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Classes="code" Text="{Binding CaCertificate}" PlaceholderText="{x:Static res:Strings.ClientSettingsWindow_EmptyToTrustTheAuthoritiesThis}" />
                                    <Button Grid.Column="1" Content="{x:Static res:Strings.ClientSettingsWindow_Browse}" Command="{Binding BrowseCommand}" CommandParameter="{x:Static vm:CertificateFileKind.Authority}" />
                                    <Button Grid.Column="2" Content="{x:Static res:Strings.ClientSettingsWindow_Clear}" Command="{Binding ClearFileCommand}" CommandParameter="{x:Static vm:CertificateFileKind.Authority}" />
                                </Grid>
                                <TextBlock Classes="info-label"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.ClientSettingsWindow_TheCertificateThatSignedTheBroker}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding HasStoreAuthorities}">
                                    <TextBlock Classes="info-label" VerticalAlignment="Center" Text="{x:Static res:Strings.ClientSettingsWindow_OrACAFromCertificates}" />
                                    <ComboBox ItemsSource="{Binding StoreAuthorities}"
                                              SelectedItem="{Binding SelectedStoreAuthority}"
                                              PlaceholderText="{x:Static res:Strings.ClientSettingsWindow_ChooseACA}"
                                              MinWidth="280"
                                              ToolTip.Tip="{x:Static res:Strings.ClientSettingsWindow_ACAMadeOnDevTools}" />
                                </StackPanel>
                            </StackPanel>

                            <CheckBox Content="{x:Static res:Strings.ClientSettingsWindow_AcceptAnyBrokerCertificateTestingOnly}"
                                      IsChecked="{Binding AcceptAnyServerCertificate}"
                                      ToolTip.Tip="{x:Static res:Strings.ClientSettingsWindow_NeitherWhoSignedTheBrokerS}" />

                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_ClientCertificateOptionalForMutualTLS}" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Classes="code" Text="{Binding ClientCertificate}" PlaceholderText="{x:Static res:Strings.ClientSettingsWindow_APEMCertificateOrAPFX}" />
                                    <Button Grid.Column="1" Content="{x:Static res:Strings.ClientSettingsWindow_Browse}" Command="{Binding BrowseCommand}" CommandParameter="{x:Static vm:CertificateFileKind.Client}" />
                                    <Button Grid.Column="2" Content="{x:Static res:Strings.ClientSettingsWindow_Clear}" Command="{Binding ClearFileCommand}" CommandParameter="{x:Static vm:CertificateFileKind.Client}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding HasStoreClients}">
                                    <TextBlock Classes="info-label" VerticalAlignment="Center" Text="{x:Static res:Strings.ClientSettingsWindow_OrOneFromCertificates}" />
                                    <ComboBox ItemsSource="{Binding StoreClients}"
                                              SelectedItem="{Binding SelectedStoreClient}"
                                              PlaceholderText="{x:Static res:Strings.ClientSettingsWindow_ChooseAClientCertificate}"
                                              MinWidth="280"
                                              ToolTip.Tip="{x:Static res:Strings.ClientSettingsWindow_AClientCertificateMadeOnDev}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding ShowKeyFile}">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_PrivateKey}" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Classes="code" Text="{Binding ClientKey}" PlaceholderText="{x:Static res:Strings.ClientSettingsWindow_EmptyWhenTheKeyIsIn}" />
                                    <Button Grid.Column="1" Content="{x:Static res:Strings.ClientSettingsWindow_Browse}" Command="{Binding BrowseCommand}" CommandParameter="{x:Static vm:CertificateFileKind.Key}" />
                                    <Button Grid.Column="2" Content="{x:Static res:Strings.ClientSettingsWindow_Clear}" Command="{Binding ClearFileCommand}" CommandParameter="{x:Static vm:CertificateFileKind.Key}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_KeyPasswordOptional}" />
                                <TextBox Text="{Binding KeyPassword}" PasswordChar="•" Width="300" HorizontalAlignment="Left" />
                                <TextBlock Classes="info-label"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.ClientSettingsWindow_OpensAPFXP12FileOr}" />
                            </StackPanel>

                            <TextBlock Classes="info-label"
                                       TextWrapping="Wrap"
                                       Text="{Binding CertificateInfo}"
                                       IsVisible="{Binding CertificateInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="error"
                                       TextWrapping="Wrap"
                                       Text="{Binding CertificateProblem}"
                                       IsVisible="{Binding CertificateProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Classes="card-title" Text="{x:Static res:Strings.ClientSettingsWindow_Appearance}" />
                            <TextBlock Classes="card-subtitle"
                                       Text="{x:Static res:Strings.ClientSettingsWindow_ColoursForThisClientSTab}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_TabText}" />
                            <Grid ColumnDefinitions="*,Auto,110" ColumnSpacing="8">
                                <ItemsControl ItemsSource="{Binding Palette}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:Swatch">
                                            <Button Classes="swatch"
                                                    Background="{Binding Brush}"
                                                    ToolTip.Tip="{Binding Name}"
                                                    Command="{Binding #Root.((vm:ClientSettingsViewModel)DataContext).PickTabTextCommand}"
                                                    CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.ClientSettingsWindow_Default}" VerticalAlignment="Center"
                                        Command="{Binding PickTabTextCommand}" CommandParameter=""
                                        ToolTip.Tip="{x:Static res:Strings.ClientSettingsWindow_UseTheThemeSColour}" />
                                <TextBox Grid.Column="2" Classes="code" Text="{Binding TabText}" PlaceholderText="{x:Static res:Strings.ClientSettingsWindow_White}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_TabFill}" />
                            <Grid ColumnDefinitions="*,Auto,110" ColumnSpacing="8">
                                <ItemsControl ItemsSource="{Binding Palette}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:Swatch">
                                            <Button Classes="swatch"
                                                    Background="{Binding Brush}"
                                                    ToolTip.Tip="{Binding Name}"
                                                    Command="{Binding #Root.((vm:ClientSettingsViewModel)DataContext).PickTabFillCommand}"
                                                    CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.ClientSettingsWindow_Default}" VerticalAlignment="Center"
                                        Command="{Binding PickTabFillCommand}" CommandParameter=""
                                        ToolTip.Tip="{x:Static res:Strings.ClientSettingsWindow_UseTheThemeSColour}" />
                                <TextBox Grid.Column="2" Classes="code" Text="{Binding TabFill}" PlaceholderText="{x:Static res:Strings.ClientSettingsWindow_Theme}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_PageBackground}" />
                            <Grid ColumnDefinitions="*,Auto,110" ColumnSpacing="8">
                                <ItemsControl ItemsSource="{Binding Palette}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:Swatch">
                                            <Button Classes="swatch"
                                                    Background="{Binding Brush}"
                                                    ToolTip.Tip="{Binding Name}"
                                                    Command="{Binding #Root.((vm:ClientSettingsViewModel)DataContext).PickPageBackgroundCommand}"
                                                    CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.ClientSettingsWindow_Default}" VerticalAlignment="Center"
                                        Command="{Binding PickPageBackgroundCommand}" CommandParameter=""
                                        ToolTip.Tip="{x:Static res:Strings.ClientSettingsWindow_UseTheThemeSColour}" />
                                <TextBox Grid.Column="2" Classes="code" Text="{Binding PageBackground}" PlaceholderText="{x:Static res:Strings.ClientSettingsWindow_Theme}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.ClientSettingsWindow_Preview}" />
                            <Border Background="{Binding PreviewPageBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" HorizontalAlignment="Left">
                                <StackPanel Spacing="8">
                                    <Border Classes="tab-header" Background="{Binding PreviewFillBrush}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Classes="state-dot" />
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource TabFontSize}" VerticalAlignment="Center" c:TabText.Foreground="{Binding PreviewTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="card" Width="260" Padding="12">
                                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.ClientSettingsWindow_Broker}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
