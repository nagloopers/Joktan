<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:Joktan.Core.Controls"
        xmlns:c="using:Joktan.Mqtt.Controls"
        xmlns:core="using:Joktan.Core"
        xmlns:vm="using:Joktan.Mqtt.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="760"
        x:Class="Joktan.Mqtt.Views.ClientSettingsWindow"
        core:HelpContext.Topic="mqtt-clients"
        x:DataType="vm:ClientSettingsViewModel"
        Width="680" Height="760"
        MinWidth="560" MinHeight="440"
        Icon="avares://Joktan.Core/Assets/joktan.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="MQTT client"
        x:Name="Root">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" FontSize="{DynamicResource DialogTitleFontSize}" Text="MQTT client" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Title}" />
                </StackPanel>
                <help:HelpButton Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="topbar" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="error"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,16,0"
                           Text="{Binding Error}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">

                <!-- Broker -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="card-title" Text="Broker" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="Name" />
                                <TextBox Text="{Binding Name}" PlaceholderText="plant-a, shown on the client's tab" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="Client ID" />
                                <TextBox Text="{Binding ClientId}" PlaceholderText="Empty to make one up" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,100" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="Host" />
                                <TextBox Text="{Binding Host}" PlaceholderText="IP address or host name" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="Port" />
                                <TextBox Text="{Binding Port}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="Username (optional)" />
                                <TextBox Text="{Binding Username}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="Password (optional)" />
                                <TextBox Text="{Binding Password}" PasswordChar="•" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- TLS -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Classes="card-title" Text="TLS" />
                            <TextBlock Classes="card-subtitle"
                                       Text="Encrypts the connection and checks the broker's certificate. Add a client certificate when the broker asks the client to prove who it is (mutual TLS)." />
                        </StackPanel>

                        <CheckBox Content="Use TLS" IsChecked="{Binding UseTls}" />

                        <StackPanel Spacing="12" IsVisible="{Binding UseTls}">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="CA certificate (optional)" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Classes="code" Text="{Binding CaCertificate}" PlaceholderText="Empty to trust the authorities this computer trusts" />
                                    <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommand}" CommandParameter="{x:Static vm:CertificateFileKind.Authority}" />
                                    <Button Grid.Column="2" Content="Clear" Command="{Binding ClearFileCommand}" CommandParameter="{x:Static vm:CertificateFileKind.Authority}" />
                                </Grid>
                                <TextBlock Classes="info-label"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="The certificate that signed the broker's, as PEM or DER. Choose it for a broker with a certificate of its own making." />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding HasStoreAuthorities}">
                                    <TextBlock Classes="info-label" VerticalAlignment="Center" Text="Or a CA from Certificates:" />
                                    <ComboBox ItemsSource="{Binding StoreAuthorities}"
                                              SelectedItem="{Binding SelectedStoreAuthority}"
                                              PlaceholderText="Choose a CA"
                                              MinWidth="280"
                                              ToolTip.Tip="A CA made on Dev Tools / Certificates. When saved, its file, with any CAs above it, is copied into this client's folder of certificates and used from there." />
                                </StackPanel>
                            </StackPanel>

                            <CheckBox Content="Accept any broker certificate (testing only)"
                                      IsChecked="{Binding AcceptAnyServerCertificate}"
                                      ToolTip.Tip="Neither who signed the broker's certificate nor its host name is checked, so the connection is encrypted but the broker is not verified." />

                            <StackPanel>
                                <TextBlock Classes="field-label" Text="Client certificate (optional, for mutual TLS)" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Classes="code" Text="{Binding ClientCertificate}" PlaceholderText="A PEM certificate, or a PFX/P12 file" />
                                    <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommand}" CommandParameter="{x:Static vm:CertificateFileKind.Client}" />
                                    <Button Grid.Column="2" Content="Clear" Command="{Binding ClearFileCommand}" CommandParameter="{x:Static vm:CertificateFileKind.Client}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding HasStoreClients}">
                                    <TextBlock Classes="info-label" VerticalAlignment="Center" Text="Or one from Certificates:" />
                                    <ComboBox ItemsSource="{Binding StoreClients}"
                                              SelectedItem="{Binding SelectedStoreClient}"
                                              PlaceholderText="Choose a client certificate"
                                              MinWidth="280"
                                              ToolTip.Tip="A client certificate made on Dev Tools / Certificates. Its key is filled in, and its CA too when none is chosen. When saved, they are copied into this client's folder of certificates and used from there." />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding ShowKeyFile}">
                                <TextBlock Classes="field-label" Text="Private key" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Classes="code" Text="{Binding ClientKey}" PlaceholderText="Empty when the key is in the certificate file" />
                                    <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommand}" CommandParameter="{x:Static vm:CertificateFileKind.Key}" />
                                    <Button Grid.Column="2" Content="Clear" Command="{Binding ClearFileCommand}" CommandParameter="{x:Static vm:CertificateFileKind.Key}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="field-label" Text="Key password (optional)" />
                                <TextBox Text="{Binding KeyPassword}" PasswordChar="•" Width="300" HorizontalAlignment="Left" />
                                <TextBlock Classes="info-label"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="Opens a PFX/P12 file or an encrypted private key. It is kept in the system's credential store after a successful connection." />
                            </StackPanel>

                            <TextBlock Classes="info-label"
                                       TextWrapping="Wrap"
                                       Text="{Binding CertificateInfo}"
                                       IsVisible="{Binding CertificateInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="error"
                                       TextWrapping="Wrap"
                                       Text="{Binding CertificateProblem}"
                                       IsVisible="{Binding CertificateProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Classes="card-title" Text="Appearance" />
                            <TextBlock Classes="card-subtitle"
                                       Text="Colours for this client's tab and the page behind its cards, on the MQTT page and in the topic explorer. Pick one, type a colour such as #3BB001, or leave it empty for the default. The default text is white on a tab with a fill." />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="Tab text" />
                            <Grid ColumnDefinitions="*,Auto,110" ColumnSpacing="8">
                                <ItemsControl ItemsSource="{Binding Palette}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:Swatch">
                                            <Button Classes="swatch"
                                                    Background="{Binding Brush}"
                                                    ToolTip.Tip="{Binding Name}"
                                                    Command="{Binding #Root.((vm:ClientSettingsViewModel)DataContext).PickTabTextCommand}"
                                                    CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Column="1" Classes="small" Content="Default" VerticalAlignment="Center"
                                        Command="{Binding PickTabTextCommand}" CommandParameter=""
                                        ToolTip.Tip="Use the theme's colour" />
                                <TextBox Grid.Column="2" Classes="code" Text="{Binding TabText}" PlaceholderText="White" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="Tab fill" />
                            <Grid ColumnDefinitions="*,Auto,110" ColumnSpacing="8">
                                <ItemsControl ItemsSource="{Binding Palette}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:Swatch">
                                            <Button Classes="swatch"
                                                    Background="{Binding Brush}"
                                                    ToolTip.Tip="{Binding Name}"
                                                    Command="{Binding #Root.((vm:ClientSettingsViewModel)DataContext).PickTabFillCommand}"
                                                    CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Column="1" Classes="small" Content="Default" VerticalAlignment="Center"
                                        Command="{Binding PickTabFillCommand}" CommandParameter=""
                                        ToolTip.Tip="Use the theme's colour" />
                                <TextBox Grid.Column="2" Classes="code" Text="{Binding TabFill}" PlaceholderText="Theme" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="Page background" />
                            <Grid ColumnDefinitions="*,Auto,110" ColumnSpacing="8">
                                <ItemsControl ItemsSource="{Binding Palette}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:Swatch">
                                            <Button Classes="swatch"
                                                    Background="{Binding Brush}"
                                                    ToolTip.Tip="{Binding Name}"
                                                    Command="{Binding #Root.((vm:ClientSettingsViewModel)DataContext).PickPageBackgroundCommand}"
                                                    CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Column="1" Classes="small" Content="Default" VerticalAlignment="Center"
                                        Command="{Binding PickPageBackgroundCommand}" CommandParameter=""
                                        ToolTip.Tip="Use the theme's colour" />
                                <TextBox Grid.Column="2" Classes="code" Text="{Binding PageBackground}" PlaceholderText="Theme" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="Preview" />
                            <Border Background="{Binding PreviewPageBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" HorizontalAlignment="Left">
                                <StackPanel Spacing="8">
                                    <Border Classes="tab-header" Background="{Binding PreviewFillBrush}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Classes="state-dot" />
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource TabFontSize}" VerticalAlignment="Center" c:TabText.Foreground="{Binding PreviewTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="card" Width="260" Padding="12">
                                        <TextBlock Classes="card-title" Text="Broker" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
