<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Joktan.Mqtt.Resources"
        xmlns:help="using:Joktan.Core.Controls"
        xmlns:core="using:Joktan.Core"
        xmlns:vm="using:Joktan.Mqtt.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="820"
        x:Class="Joktan.Mqtt.Views.MessageSettingsWindow"
        core:HelpContext.Topic="mqtt-message-settings"
        x:DataType="vm:MessageSettingsViewModel"
        x:Name="Root"
        Width="760" Height="820"
        MinWidth="640" MinHeight="480"
        Icon="avares://Joktan.Core/Assets/joktan.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="{x:Static res:Strings.MessageSettingsWindow_MessageSettings}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" FontSize="{DynamicResource DialogTitleFontSize}" Text="{x:Static res:Strings.MessageSettingsWindow_MessageSettings}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Title}" />
                </StackPanel>
                <help:HelpButton Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="topbar" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="error"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,16,0"
                           Text="{Binding Error}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static res:Strings.MessageSettingsWindow_Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Classes="accent" Content="{x:Static res:Strings.MessageSettingsWindow_Save}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">

                <!-- Delivery -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.MessageSettingsWindow_Delivery}" />
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_TopicOptional}" />
                            <TextBox Classes="code" Text="{Binding Topic}" PlaceholderText="{Binding TopicPlaceholder}" />
                            <TextBlock Classes="info-label"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.MessageSettingsWindow_LeaveEmptyToSendToThe}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_GroupOptional}" />
                            <AutoCompleteBox Text="{Binding Group}"
                                             ItemsSource="{Binding GroupNames}"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="0"
                                             PlaceholderText="{x:Static res:Strings.MessageSettingsWindow_PlantLine1MakesLine1}"
                                             Width="420"
                                             HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <CheckBox Content="{x:Static res:Strings.MessageSettingsWindow_SwitchedOn}"
                                      IsChecked="{Binding Enabled}"
                                      ToolTip.Tip="{x:Static res:Strings.MessageSettingsWindow_SentOnItsScheduleWhileThe}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_QoS}" VerticalAlignment="Center" Margin="0" />
                                <ComboBox SelectedIndex="{Binding QosIndex}" MinWidth="70">
                                    <ComboBoxItem Content="0" />
                                    <ComboBoxItem Content="1" />
                                    <ComboBoxItem Content="2" />
                                </ComboBox>
                            </StackPanel>
                            <CheckBox Content="{x:Static res:Strings.MessageSettingsWindow_Retain}" IsChecked="{Binding Retain}" />
                            <CheckBox Content="{x:Static res:Strings.MessageSettingsWindow_Gzip}"
                                      IsChecked="{Binding Gzip}"
                                      ToolTip.Tip="{x:Static res:Strings.MessageSettingsWindow_CompressTheBodyWithGzipBefore}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Topic fields -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="card-title" Text="{x:Static res:Strings.MessageSettingsWindow_TopicFields}" />
                                <TextBlock Classes="card-subtitle"
                                           Text="{x:Static res:Strings.MessageSettingsWindow_PartsOfTheTopicWrittenAs}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{x:Static res:Strings.MessageSettingsWindow_AddTopicField}" VerticalAlignment="Top" Command="{Binding AddTopicFieldCommand}" />
                        </Grid>

                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.MessageSettingsWindow_NoTopicFieldsEverySendGoes}" IsVisible="{Binding !TopicFields.Count}" />

                        <ItemsControl ItemsSource="{Binding TopicFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FieldRuleViewModel">
                                    <Border Classes="table-row">
                                        <Grid ColumnDefinitions="*,200,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                                            <StackPanel>
                                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Name}" />
                                                <AutoCompleteBox Text="{Binding Path}"
                                                                 ItemsSource="{Binding #Root.((vm:MessageSettingsViewModel)DataContext).TopicNames}"
                                                                 FilterMode="Contains"
                                                                 MinimumPrefixLength="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1">
                                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_NewValue}" />
                                                <ComboBox SelectedIndex="{Binding TypeIndex}"
                                                          ItemsSource="{x:Static vm:FieldRuleViewModel.TypeNames}"
                                                          HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                            <Button Grid.Row="0" Grid.Column="2"
                                                    Classes="small"
                                                    Content="{x:Static res:Strings.MessageSettingsWindow_Remove}"
                                                    VerticalAlignment="Bottom"
                                                    Command="{Binding #Root.((vm:MessageSettingsViewModel)DataContext).RemoveFieldCommand}"
                                                    CommandParameter="{Binding}" />

                                            <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12">
                                                <StackPanel IsVisible="{Binding ShowCounter}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Start}" />
                                                    <TextBox Text="{Binding Start}" Width="110" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowCounter}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Step}" />
                                                    <TextBox Text="{Binding Step}" Width="110" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowRange}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Minimum}" />
                                                    <TextBox Text="{Binding Min}" Width="110" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowRange}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Maximum}" />
                                                    <TextBox Text="{Binding Max}" Width="110" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowDecimals}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Decimals}" />
                                                    <TextBox Text="{Binding Decimals}" Width="90" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowFixed}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Type}" />
                                                    <ComboBox SelectedIndex="{Binding ValueKindIndex}"
                                                              ItemsSource="{x:Static vm:FieldRuleViewModel.ValueKindNames}"
                                                              Width="150" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowFixedText}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Value}" />
                                                    <TextBox Text="{Binding FixedText}" Width="320" PlaceholderText="{Binding FixedPlaceholder}" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowFixedSwitch}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Value}" />
                                                    <ToggleSwitch IsChecked="{Binding FixedBool}" OnContent="true" OffContent="false" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowValues}">
                                                    <TextBlock Classes="field-label" Text="{Binding ValuesLabel}" />
                                                    <TextBox Text="{Binding Values}" Width="320" PlaceholderText="sensor-01, sensor-02, sensor-03" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowChoices}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Value}" />
                                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" MinWidth="150" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Schedule -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.MessageSettingsWindow_Schedule}" />
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_WhenToSend}" />
                            <ComboBox SelectedIndex="{Binding ScheduleTypeIndex}" MinWidth="260">
                                <ComboBoxItem Content="{x:Static res:Strings.MessageSettingsWindow_ManualOnlyWhenIPressSend}" />
                                <ComboBoxItem Content="{x:Static res:Strings.MessageSettingsWindow_OnceAtADateAndTime}" />
                                <ComboBoxItem Content="{x:Static res:Strings.MessageSettingsWindow_RecurringAtAFixedInterval}" />
                                <ComboBoxItem Content="{x:Static res:Strings.MessageSettingsWindow_RecurringDailyAtSetTimes}" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOnce}">
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_DateAndTimeLocal}" />
                            <TextBox Text="{Binding OnceAt}" PlaceholderText="2026-11-02 08:30:00" Width="260" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsInterval}" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Every}" />
                                    <TextBox Text="{Binding Every}" Width="90" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Unit}" />
                                    <ComboBox SelectedIndex="{Binding UnitIndex}" MinWidth="130">
                                        <ComboBoxItem Content="{x:Static res:Strings.MessageSettingsWindow_Seconds}" />
                                        <ComboBoxItem Content="{x:Static res:Strings.MessageSettingsWindow_Minutes}" />
                                        <ComboBoxItem Content="{x:Static res:Strings.MessageSettingsWindow_Hours}" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_StartOptional}" />
                                    <TextBox Text="{Binding IntervalStart}" PlaceholderText="{x:Static res:Strings.MessageSettingsWindow_WhenTheRunStarts}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_EndOptional}" />
                                    <TextBox Text="{Binding IntervalEnd}" PlaceholderText="{x:Static res:Strings.MessageSettingsWindow_NoEnd}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_MaximumSendsOptional}" />
                                    <TextBox Text="{Binding MaxSends}" PlaceholderText="{x:Static res:Strings.MessageSettingsWindow_NoLimit}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Classes="info-label" Text="{x:Static res:Strings.MessageSettingsWindow_DatesAndTimesAreLocalWritten}" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsDaily}" Spacing="12">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_TimesOfDaySeparatedByCommas}" />
                                <TextBox Text="{Binding DailyTimes}" PlaceholderText="08:00, 12:30" />
                            </StackPanel>
                            <WrapPanel>
                                <CheckBox Content="{x:Static res:Strings.MessageSettingsWindow_Mon}" IsChecked="{Binding Monday}" Margin="0,0,16,0" />
                                <CheckBox Content="{x:Static res:Strings.MessageSettingsWindow_Tue}" IsChecked="{Binding Tuesday}" Margin="0,0,16,0" />
                                <CheckBox Content="{x:Static res:Strings.MessageSettingsWindow_Wed}" IsChecked="{Binding Wednesday}" Margin="0,0,16,0" />
                                <CheckBox Content="{x:Static res:Strings.MessageSettingsWindow_Thu}" IsChecked="{Binding Thursday}" Margin="0,0,16,0" />
                                <CheckBox Content="{x:Static res:Strings.MessageSettingsWindow_Fri}" IsChecked="{Binding Friday}" Margin="0,0,16,0" />
                                <CheckBox Content="{x:Static res:Strings.MessageSettingsWindow_Sat}" IsChecked="{Binding Saturday}" Margin="0,0,16,0" />
                                <CheckBox Content="{x:Static res:Strings.MessageSettingsWindow_Sun}" IsChecked="{Binding Sunday}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Array sizes -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="card-title" Text="{x:Static res:Strings.MessageSettingsWindow_ArraySizes}" />
                                <TextBlock Classes="card-subtitle"
                                           Text="{x:Static res:Strings.MessageSettingsWindow_SendAnArrayWithASet}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{x:Static res:Strings.MessageSettingsWindow_AddArray}" VerticalAlignment="Top" Command="{Binding AddArrayCommand}" />
                        </Grid>

                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.MessageSettingsWindow_NoArraySizesArraysAreSent}" IsVisible="{Binding !Arrays.Count}" />

                        <ItemsControl ItemsSource="{Binding Arrays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArrayRuleViewModel">
                                    <Border Classes="table-row">
                                        <Grid ColumnDefinitions="*,110,110,Auto" ColumnSpacing="12">
                                            <StackPanel>
                                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Array}" />
                                                <AutoCompleteBox Text="{Binding Path}"
                                                                 ItemsSource="{Binding #Root.((vm:MessageSettingsViewModel)DataContext).ArrayPaths}"
                                                                 FilterMode="Contains"
                                                                 MinimumPrefixLength="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Items}" />
                                                <TextBox Text="{Binding Items}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_UpToOptional}" />
                                                <TextBox Text="{Binding MaxItems}" PlaceholderText="{x:Static res:Strings.MessageSettingsWindow_Fixed}" />
                                            </StackPanel>
                                            <Button Grid.Column="3"
                                                    Classes="small"
                                                    Content="{x:Static res:Strings.MessageSettingsWindow_Remove}"
                                                    VerticalAlignment="Bottom"
                                                    Command="{Binding #Root.((vm:MessageSettingsViewModel)DataContext).RemoveArrayCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Varying fields -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="card-title" Text="{x:Static res:Strings.MessageSettingsWindow_VaryingFields}" />
                                <TextBlock Classes="card-subtitle"
                                           Text="{x:Static res:Strings.MessageSettingsWindow_FieldsOfTheBodyThatGet}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{x:Static res:Strings.MessageSettingsWindow_AddField}" VerticalAlignment="Top" Command="{Binding AddFieldCommand}" />
                        </Grid>

                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.MessageSettingsWindow_NoVaryingFields}" IsVisible="{Binding !Fields.Count}" />

                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FieldRuleViewModel">
                                    <Border Classes="table-row">
                                        <Grid ColumnDefinitions="*,200,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                                            <StackPanel>
                                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Field}" />
                                                <AutoCompleteBox Text="{Binding Path}"
                                                                 ItemsSource="{Binding #Root.((vm:MessageSettingsViewModel)DataContext).BodyPaths}"
                                                                 FilterMode="Contains"
                                                                 MinimumPrefixLength="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1">
                                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_NewValue}" />
                                                <ComboBox SelectedIndex="{Binding TypeIndex}"
                                                          ItemsSource="{x:Static vm:FieldRuleViewModel.TypeNames}"
                                                          HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                            <Button Grid.Row="0" Grid.Column="2"
                                                    Classes="small"
                                                    Content="{x:Static res:Strings.MessageSettingsWindow_Remove}"
                                                    VerticalAlignment="Bottom"
                                                    Command="{Binding #Root.((vm:MessageSettingsViewModel)DataContext).RemoveFieldCommand}"
                                                    CommandParameter="{Binding}" />

                                            <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12">
                                                <StackPanel IsVisible="{Binding ShowCounter}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Start}" />
                                                    <TextBox Text="{Binding Start}" Width="110" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowCounter}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Step}" />
                                                    <TextBox Text="{Binding Step}" Width="110" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowRange}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Minimum}" />
                                                    <TextBox Text="{Binding Min}" Width="110" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowRange}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Maximum}" />
                                                    <TextBox Text="{Binding Max}" Width="110" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowDecimals}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Decimals}" />
                                                    <TextBox Text="{Binding Decimals}" Width="90" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowFixed}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Type}" />
                                                    <ComboBox SelectedIndex="{Binding ValueKindIndex}"
                                                              ItemsSource="{x:Static vm:FieldRuleViewModel.ValueKindNames}"
                                                              Width="150" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowFixedText}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Value}" />
                                                    <TextBox Text="{Binding FixedText}" Width="320" PlaceholderText="{Binding FixedPlaceholder}" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowFixedSwitch}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Value}" />
                                                    <ToggleSwitch IsChecked="{Binding FixedBool}" OnContent="true" OffContent="false" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowValues}">
                                                    <TextBlock Classes="field-label" Text="{Binding ValuesLabel}" />
                                                    <TextBox Text="{Binding Values}" Width="320" PlaceholderText="{x:Static res:Strings.MessageSettingsWindow_OpenClosed42}" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ShowChoices}">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessageSettingsWindow_Value}" />
                                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" MinWidth="150" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Classes="card-title" Text="{x:Static res:Strings.MessageSettingsWindow_Preview}" />
                            <TextBlock Classes="card-subtitle" Text="{x:Static res:Strings.MessageSettingsWindow_TheTopicAndBodyAsThey}" />
                        </StackPanel>
                        <TextBox Classes="code" Text="{Binding TopicPreview, Mode=OneWay}" IsReadOnly="True" />
                        <TextBox Classes="code"
                                 Text="{Binding Preview, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 MaxHeight="240" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
