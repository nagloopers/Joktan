<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Mqtt.Resources"
             xmlns:vm="using:Joktan.Mqtt.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="736"
             x:Class="Joktan.Mqtt.Views.MessagingView"
             x:DataType="vm:MessagingViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="24">

                <!-- Server -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="card-title" Text="{x:Static res:Strings.MessagingView_Server}" />
                                <TextBlock Classes="card-subtitle"
                                           TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.MessagingView_TheMQTTServerThatAlertsAnd}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Top"
                                    Content="{x:Static res:Strings.MessagingView_EditServer}"
                                    Command="{Binding Client.EditClientCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.MessagingView_ChangeTheServerLoginAndCertificates}" />
                        </Grid>

                        <Grid ColumnDefinitions="2*,*,1.4*,*" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessagingView_Server}" />
                                <TextBlock Classes="table-cell" Text="{Binding Client.Address}" ToolTip.Tip="{Binding Client.Address}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessagingView_Login}" />
                                <TextBlock Classes="table-cell" Text="{Binding Client.Login}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessagingView_ClientID}" />
                                <TextBlock Classes="table-cell" Text="{Binding Client.ClientId}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessagingView_Security}" />
                                <TextBlock Classes="table-cell" Text="{Binding Client.Security}" ToolTip.Tip="{Binding Client.SecurityDetail}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding Client.SecurityDetail}" />

                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Ellipse Classes="state-dot"
                                     Classes.ok="{Binding Client.IsConnected}"
                                     Classes.pending="{Binding Client.IsPending}"
                                     Classes.failed="{Binding Client.IsFailed}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,16,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="{Binding Client.StateText}" />
                            <Panel Grid.Column="2">
                                <Button Classes="accent"
                                        Content="{x:Static res:Strings.MessagingView_Connect}"
                                        Command="{Binding Client.ConnectCommand}"
                                        IsVisible="{Binding Client.CanEdit}" />
                                <Button Content="{Binding Client.DisconnectText}"
                                        Command="{Binding Client.DisconnectCommand}"
                                        IsVisible="{Binding Client.ShowDisconnect}" />
                            </Panel>
                        </Grid>
                        <TextBlock Classes="error"
                                   TextWrapping="Wrap"
                                   Text="{Binding Client.FailureReason}"
                                   IsVisible="{Binding Client.FailureReason, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessagingView_ConnectWhenJoktanStarts}" />
                                <TextBlock Classes="info-label"
                                           TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.MessagingView_ItTriesAgainUpTo3}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          Classes="compact"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ConnectOnStart}"
                                          ToolTip.Tip="{x:Static res:Strings.MessagingView_ConnectToThisServerWhenJoktan}" />
                        </Grid>

                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessagingView_TopicPrefix}" />
                            <TextBox Classes="code" Text="{Binding TopicPrefix}" Width="360" HorizontalAlignment="Left" />
                            <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.MessagingView_WhatTheTopicsOfAlertsAnd}" />
                            <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding TopicPrefixError}"
                                       IsVisible="{Binding TopicPrefixError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessagingView_ShowUnderDevToolsBrokers}" />
                                <TextBlock Classes="info-label"
                                           TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.MessagingView_GivesTheServerATabOf}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          Classes="compact"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ShowInBrokers}"
                                          ToolTip.Tip="{x:Static res:Strings.MessagingView_ShowThisServerOnTheMQTT}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Identity -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Classes="card-title" Text="{x:Static res:Strings.MessagingView_You}" />
                            <TextBlock Classes="card-subtitle" Text="{x:Static res:Strings.MessagingView_TheNameAndPictureForYour}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Panel Width="48" Height="48" VerticalAlignment="Top">
                                <Ellipse Fill="{DynamicResource AccentBrush}" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           Text="{Binding AvatarInitial}" />
                                <Border CornerRadius="24" ClipToBounds="True" IsVisible="{Binding HasAvatar}">
                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                </Border>
                            </Panel>

                            <StackPanel Grid.Column="1" Spacing="12">
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.MessagingView_DisplayName}" />
                                    <TextBox Text="{Binding DisplayName}" MaxLength="{Binding MaxDisplayNameLength}" Width="360" HorizontalAlignment="Left" PlaceholderText="ada" />
                                    <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="{x:Static res:Strings.MessagingView_OthersWriteToYouWithAnd}" />
                                    <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding DisplayNameError}"
                                               IsVisible="{Binding DisplayNameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding DisplayNameWarning}"
                                               IsVisible="{Binding DisplayNameWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{x:Static res:Strings.MessagingView_ChoosePicture}" Command="{Binding ChooseAvatarCommand}"
                                            ToolTip.Tip="{x:Static res:Strings.MessagingView_KeepsASmallSquareCopyCut}" />
                                    <Button Content="{x:Static res:Strings.MessagingView_RemovePicture}" Command="{Binding RemoveAvatarCommand}" />
                                </StackPanel>
                                <TextBlock Classes="error"
                                           TextWrapping="Wrap"
                                           Text="{Binding AvatarError}"
                                           IsVisible="{Binding AvatarError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</UserControl>
