<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Joktan.Mqtt.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="736"
             x:Class="Joktan.Mqtt.Views.MessagingView"
             x:DataType="vm:MessagingViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="24">

                <!-- Server -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="card-title" Text="Server" />
                                <TextBlock Classes="card-subtitle"
                                           TextWrapping="Wrap"
                                           Text="The MQTT server that alerts and messages go through. It is set up like a client on the MQTT page, but is kept apart from them." />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Top"
                                    Content="Edit server"
                                    Command="{Binding Client.EditClientCommand}"
                                    ToolTip.Tip="Change the server, login and certificates. Disconnect first." />
                        </Grid>

                        <Grid ColumnDefinitions="2*,*,1.4*,*" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="Server" />
                                <TextBlock Classes="table-cell" Text="{Binding Client.Address}" ToolTip.Tip="{Binding Client.Address}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="Login" />
                                <TextBlock Classes="table-cell" Text="{Binding Client.Login}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="field-label" Text="Client ID" />
                                <TextBlock Classes="table-cell" Text="{Binding Client.ClientId}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Classes="field-label" Text="Security" />
                                <TextBlock Classes="table-cell" Text="{Binding Client.Security}" ToolTip.Tip="{Binding Client.SecurityDetail}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding Client.SecurityDetail}" />

                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Ellipse Classes="state-dot"
                                     Classes.ok="{Binding Client.IsConnected}"
                                     Classes.pending="{Binding Client.IsPending}"
                                     Classes.failed="{Binding Client.IsFailed}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,16,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="{Binding Client.StateText}" />
                            <Panel Grid.Column="2">
                                <Button Classes="accent"
                                        Content="Connect"
                                        Command="{Binding Client.ConnectCommand}"
                                        IsVisible="{Binding Client.CanEdit}" />
                                <Button Content="{Binding Client.DisconnectText}"
                                        Command="{Binding Client.DisconnectCommand}"
                                        IsVisible="{Binding Client.ShowDisconnect}" />
                            </Panel>
                        </Grid>
                        <TextBlock Classes="error"
                                   TextWrapping="Wrap"
                                   Text="{Binding Client.FailureReason}"
                                   IsVisible="{Binding Client.FailureReason, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="Connect when Joktan starts" />
                                <TextBlock Classes="info-label"
                                           TextWrapping="Wrap"
                                           Text="It tries again up to 3 times if it cannot connect. Alerts and messages only arrive while connected; those sent at any other time are not received." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          Classes="compact"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ConnectOnStart}"
                                          ToolTip.Tip="Connect to this server when Joktan starts" />
                        </Grid>

                        <StackPanel>
                            <TextBlock Classes="field-label" Text="Topic prefix" />
                            <TextBox Classes="code" Text="{Binding TopicPrefix}" Width="360" HorizontalAlignment="Left" />
                            <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="What the topics of alerts and messages start with. Everyone with the same prefix on this server shares them." />
                            <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding TopicPrefixError}"
                                       IsVisible="{Binding TopicPrefixError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="Show under Dev Tools / Brokers" />
                                <TextBlock Classes="info-label"
                                           TextWrapping="Wrap"
                                           Text="Gives the server a tab of its own on the MQTT and Topic Explorer pages, to see and send what goes through it." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          Classes="compact"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ShowInBrokers}"
                                          ToolTip.Tip="Show this server on the MQTT and Topic Explorer pages" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Identity -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Classes="card-title" Text="You" />
                            <TextBlock Classes="card-subtitle" Text="The name and picture for your messages." />
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Panel Width="48" Height="48" VerticalAlignment="Top">
                                <Ellipse Fill="{DynamicResource AccentBrush}" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           Text="{Binding AvatarInitial}" />
                                <Border CornerRadius="24" ClipToBounds="True" IsVisible="{Binding HasAvatar}">
                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                </Border>
                            </Panel>

                            <StackPanel Grid.Column="1" Spacing="12">
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="Display name" />
                                    <TextBox Text="{Binding DisplayName}" MaxLength="{Binding MaxDisplayNameLength}" Width="360" HorizontalAlignment="Left" PlaceholderText="ada" />
                                    <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Others write to you with @ and this name. Lowercase letters, digits, _ and -, with no spaces, and at most 15 characters." />
                                    <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding DisplayNameError}"
                                               IsVisible="{Binding DisplayNameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding DisplayNameWarning}"
                                               IsVisible="{Binding DisplayNameWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Choose picture" Command="{Binding ChooseAvatarCommand}"
                                            ToolTip.Tip="Keeps a small square copy, cut from the middle of the picture. The file you choose is left as it is." />
                                    <Button Content="Remove picture" Command="{Binding RemoveAvatarCommand}" />
                                </StackPanel>
                                <TextBlock Classes="error"
                                           TextWrapping="Wrap"
                                           Text="{Binding AvatarError}"
                                           IsVisible="{Binding AvatarError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</UserControl>
