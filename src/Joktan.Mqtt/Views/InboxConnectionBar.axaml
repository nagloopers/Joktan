<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Joktan.Mqtt.ViewModels"
             x:Class="Joktan.Mqtt.Views.InboxConnectionBar"
             x:DataType="vm:InboxViewModel">
    <StackPanel Spacing="4">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Ellipse Classes="state-dot"
                     Classes.ok="{Binding Client.IsConnected}"
                     Classes.pending="{Binding Client.IsPending}"
                     Classes.failed="{Binding Client.IsFailed}" />
            <TextBlock Grid.Column="1" Classes="info-label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding Client.Address}" ToolTip.Tip="{Binding Client.StateText}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button Classes="small" Content="Connect" Command="{Binding Client.ConnectCommand}" IsVisible="{Binding Client.CanEdit}" />
                <Button Classes="small" Content="Server" Command="{Binding ShowSettingsCommand}"
                        ToolTip.Tip="Set up the server under Settings / Alerts and Messages" />
            </StackPanel>
        </Grid>
        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Client.FailureReason}"
                   IsVisible="{Binding Client.FailureReason, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
</UserControl>
