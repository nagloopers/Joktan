<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Joktan.Mqtt.ViewModels"
             xmlns:views="using:Joktan.Mqtt.Views"
             xmlns:controls="using:Joktan.Core.Controls"
             x:Class="Joktan.Mqtt.Views.InboxMessagesPanel"
             x:DataType="vm:InboxViewModel"
             Width="380" Height="480">
    <UserControl.Styles>
        <Style Selector="Grid.found">
            <Setter Property="Background" Value="{DynamicResource AccentTrackBrush}" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="card-title" VerticalAlignment="Center" Text="Messages" />
                <Button Grid.Column="1" Classes="small" Content="Clear" Command="{Binding ClearMessagesCommand}"
                        ToolTip.Tip="Clear this list on this computer. Nothing changes for anyone else." />
            </Grid>
            <views:InboxConnectionBar />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsReplying}">
                <TextBlock Classes="info-label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding ReplyingText}" ToolTip.Tip="{Binding ReplyingText}" />
                <Button Grid.Column="1" Classes="small" Content="Cancel" Command="{Binding CancelReplyCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Suggestions}" IsVisible="{Binding HasSuggestions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="4" LineSpacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Classes="small" Content="{Binding StringFormat='@{0}'}"
                                Command="{Binding $parent[UserControl].((vm:InboxViewModel)DataContext).PickSuggestionCommand}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="DraftBox" Text="{Binding Draft}" MaxLength="{Binding MaxMessageLength}" PlaceholderText="To everyone, or @name for one person" TextWrapping="Wrap" MaxHeight="100">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Classes="accent" Content="Send" VerticalAlignment="Bottom" Command="{Binding SendCommand}" />
            </Grid>
            <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding SendError}"
                       IsVisible="{Binding SendError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <Panel>
            <TextBlock Classes="info-label" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No messages yet" IsVisible="{Binding !HasMessages}" />
            <ScrollViewer x:Name="Scroller">
                <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatRowViewModel">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,12,4" Classes.found="{Binding IsFound}">
                                <Panel Width="28" Height="28" VerticalAlignment="Top">
                                    <Ellipse Fill="{DynamicResource AccentBrush}" />
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource OnAccentBrush}" Text="{Binding Initial}" />
                                    <Border CornerRadius="14" ClipToBounds="True" IsVisible="{Binding HasAvatar}">
                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                    </Border>
                                </Panel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" controls:TextHighlight.Source="{Binding Name}" controls:TextHighlight.Words="{Binding FoundWords}" />
                                        <TextBlock Classes="info-label" VerticalAlignment="Center" Text="{Binding Time}" />
                                        <TextBlock Classes="info-label" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding DirectText}" IsVisible="{Binding IsDirect}" />
                                    </StackPanel>
                                    <TextBlock Classes="info-label" TextTrimming="CharacterEllipsis" Text="{Binding ReplyLine}" IsVisible="{Binding IsReply}" />
                                    <SelectableTextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" controls:TextHighlight.Source="{Binding Text}" controls:TextHighlight.Words="{Binding FoundWords}" />
                                    <Button Classes="small" Content="Reply" HorizontalAlignment="Left" Margin="0,2,0,0"
                                            IsVisible="{Binding CanReply}"
                                            Command="{Binding $parent[UserControl].((vm:InboxViewModel)DataContext).ReplyCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Answer this person only" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
