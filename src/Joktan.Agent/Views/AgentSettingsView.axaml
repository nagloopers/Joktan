<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Agent.Resources"
             xmlns:vm="using:Joktan.Agent.ViewModels"
             xmlns:agent="using:Joktan.Agent"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="736"
             x:Class="Joktan.Agent.Views.AgentSettingsView"
             x:DataType="vm:AgentSettingsViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.AgentSettingsView_CommandLineClient}" />
                        <TextBlock Classes="card-subtitle" Text="{x:Static res:Strings.AgentSettingsView_TheAgentInThePanelRuns}" />

                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.AgentSettingsView_Client}" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Agent.Clients}" SelectedItem="{Binding Agent.SelectedClient}"
                                  IsEnabled="{Binding Agent.IsIdle}" />

                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.AgentSettingsView_Program}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding ProgramPath}" PlaceholderText="{Binding PathHint}" />
                            <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.AgentSettingsView_Check}" Command="{Binding CheckCommand}" />
                        </Grid>
                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding ClientStatus}" IsVisible="{Binding ClientFound}" />
                        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding ClientStatus}" IsVisible="{Binding !ClientFound}" />

                        <StackPanel Spacing="4" IsVisible="{Binding IsCustom}">
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.AgentSettingsView_Arguments}" />
                            <TextBox Classes="code" Text="{Binding CustomArguments}" />
                            <TextBlock Classes="info-label" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.AgentSettingsView_PromptIsWhatYouSaidMcp}" />
                        </StackPanel>

                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.AgentSettingsView_Model}" />
                        <TextBox Text="{Binding Model}" PlaceholderText="{Binding ModelHint}" />

                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.AgentSettingsView_MoreArguments}" />
                        <TextBox Classes="code" Text="{Binding ExtraArguments}" PlaceholderText="{x:Static res:Strings.AgentSettingsView_AddedToTheCommandLineEach}" />

                        <Border Classes="table-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel>
                                    <TextBlock Classes="table-cell" Text="{x:Static res:Strings.AgentSettingsView_AlsoLetTheAgentUseThe}" />
                                    <TextBlock Classes="info-label" TextWrapping="Wrap"
                                               Text="{x:Static res:Strings.AgentSettingsView_SuchAsItsShellAndFile}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding AllowClientTools}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.AgentSettingsView_Prompts}" />
                        <TextBlock Classes="card-subtitle" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.AgentSettingsView_RequestsKeptReadyOfferedByThe}" />

                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.AgentSettingsView_NoPromptsAddOneBelow}" IsVisible="{Binding Agent.HasNoPrompts}" />
                        <ItemsControl Name="PromptList" ItemsSource="{Binding Agent.Prompts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="agent:AgentPrompt">
                                    <Border Classes="table-row">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Classes="table-cell" Text="{Binding Name}" />
                                                <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding Text}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.AgentSettingsView_Remove}" VerticalAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:AgentSettingsViewModel)DataContext).RemovePromptCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.AgentSettingsView_Name}" />
                        <TextBox Text="{Binding NewPromptName}" PlaceholderText="{x:Static res:Strings.AgentSettingsView_WhatTheChatListsItAs}" />
                        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding NewPromptProblem}"
                                   IsVisible="{Binding NewPromptProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.AgentSettingsView_Prompt}" />
                        <TextBox Text="{Binding NewPromptText}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160"
                                 PlaceholderText="{x:Static res:Strings.AgentSettingsView_WhatGoesInTheMessageBox}" />

                        <Button Classes="small" Content="{x:Static res:Strings.AgentSettingsView_AddPrompt}" Command="{Binding AddPromptCommand}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.AgentSettingsView_Speech}" />
                        <TextBlock Classes="card-subtitle" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.AgentSettingsView_EverythingHereHappensOnThisComputer}" />

                        <Border Classes="table-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="table-cell" Text="{x:Static res:Strings.AgentSettingsView_ReadRepliesAloud}" />
                                <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Agent.IsReadingAloud}" />
                            </Grid>
                        </Border>
                        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding SpeechProblem}"
                                   IsVisible="{Binding SpeechProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <Border Classes="table-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel>
                                    <TextBlock Classes="table-cell" Text="{x:Static res:Strings.AgentSettingsView_VoiceInput}" />
                                    <TextBlock Classes="info-label" TextWrapping="Wrap"
                                               Text="{x:Static res:Strings.AgentSettingsView_ShowsAMicrophoneButtonInThe}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding VoiceInput}" />
                            </Grid>
                        </Border>
                        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding VoiceProblem}"
                                   IsVisible="{Binding VoiceProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.AgentSettingsView_Voice}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" />
                            <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.AgentSettingsView_TryIt}" Command="{Binding TrySpeechCommand}" />
                        </Grid>

                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.AgentSettingsView_Speed}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Slider Minimum="50" Maximum="200" SmallChange="10" LargeChange="10" Value="{Binding SpeechSpeed}" />
                            <TextBlock Grid.Column="1" Classes="info-label" VerticalAlignment="Center" Text="{Binding SpeechSpeedText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.AgentSettingsView_ClientsOutsideTheApp}" />
                        <TextBlock Classes="card-subtitle" Text="{x:Static res:Strings.AgentSettingsView_LetAnotherMCPClientOnThis}" />

                        <Border Classes="table-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="table-cell" Text="{x:Static res:Strings.AgentSettingsView_LetOutsideClientsConnect}" />
                                <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding OutsideEnabled}" />
                            </Grid>
                        </Border>

                        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Agent.ServerProblem}"
                                   IsVisible="{Binding Agent.ServerProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.AgentSettingsView_Port}" />
                        <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding OutsidePort}" />

                        <StackPanel Spacing="8" IsVisible="{Binding OutsideEnabled}">
                            <TextBlock Classes="info-label" Text="{Binding OutsideUrl}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="small" Content="{x:Static res:Strings.AgentSettingsView_CopyConfiguration}" Command="{Binding CopyConfigurationCommand}" />
                                <Button Classes="small" Content="{x:Static res:Strings.AgentSettingsView_ReplaceToken}" Command="{Binding ReplaceTokenCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding Message}"
                                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
