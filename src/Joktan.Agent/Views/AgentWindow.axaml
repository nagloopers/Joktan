<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Joktan.Agent.Resources"
        xmlns:views="using:Joktan.Agent.Views"
        xmlns:core="using:Joktan.Core"
        x:Class="Joktan.Agent.Views.AgentWindow"
        Icon="avares://Joktan.Core/Assets/joktan.ico"
        MinWidth="320" MinHeight="360"
        Background="{DynamicResource AppBackgroundBrush}"
        core:HelpContext.Topic="agent"
        Title="{x:Static res:Strings.AgentWindow_JoktanAgent}">
    <views:AgentPanel />
</Window>
