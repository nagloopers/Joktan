<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Joktan.Help.Resources"
        xmlns:vm="using:Joktan.Help.ViewModels"
        xmlns:core="using:Joktan.Core"
        xmlns:controls="using:Joktan.Core.Controls"
        x:Class="Joktan.Help.Views.HelpWindow"
        x:DataType="vm:HelpViewModel"
        Icon="avares://Joktan.Core/Assets/joktan.ico"
        Width="1040" Height="760"
        MinWidth="720" MinHeight="480"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Title="{x:Static res:Strings.HelpWindow_HelpJoktan}">

    <Window.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <!-- The muted colour is too faint on a selected row -->
        <Style Selector="ListBoxItem:selected TextBlock.info-label">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="TextBlock.help-child">
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- The window's title bar, as in the main window: drag it to move the window, double-click to maximise -->
        <Border DockPanel.Dock="Top"
                Classes="topbar"
                Height="{StaticResource TopBarHeight}"
                PointerPressed="OnTopBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Classes="small"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Content="{x:Static res:Strings.HelpWindow_Back}"
                        Command="{Binding GoBackCommand}"
                        ToolTip.Tip="{x:Static res:Strings.HelpWindow_GoBackToTheTopicRead}" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Text="{x:Static res:Strings.HelpWindow_Help}" />

                <!-- Window controls, in place of the system title bar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="20,0,0,0">
                    <Button Classes="window-button" ToolTip.Tip="{x:Static res:Strings.HelpWindow_Minimise}" Click="OnMinimizeClick">
                        <PathIcon Data="{x:Static core:Icons.WindowMinimize}" />
                    </Button>
                    <Button Classes="window-button" ToolTip.Tip="{x:Static res:Strings.HelpWindow_Maximise}" Name="MaximizeButton" Click="OnMaximizeClick">
                        <PathIcon Name="MaximizeIcon" Data="{x:Static core:Icons.WindowMaximize}" />
                    </Button>
                    <Button Classes="window-button close" ToolTip.Tip="{x:Static res:Strings.HelpWindow_Close}" Click="OnCloseClick">
                        <PathIcon Data="{x:Static core:Icons.WindowClose}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="24" ColumnDefinitions="280,16,*">

            <!-- The topics -->
            <Border Classes="card" Padding="8">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top"
                             Margin="4,4,4,8"
                             Text="{Binding SearchText}"
                             PlaceholderText="{x:Static res:Strings.HelpWindow_SearchHelp}" />
                    <Panel>
                        <TextBlock Classes="info-label" Margin="12" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.HelpWindow_NoTopicMentionsThat}"
                                   IsVisible="{Binding HasNoMatches}" />
                        <ListBox Background="Transparent"
                                 ItemsSource="{Binding VisibleTopics}"
                                 SelectedItem="{Binding ListSelection}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:HelpTopicViewModel">
                                    <StackPanel>
                                        <TextBlock Classes.help-child="{Binding IsIndented}"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="info-label"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Snippet}"
                                                   IsVisible="{Binding HasSnippet}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </DockPanel>
            </Border>

            <!-- The topic being read -->
            <Border Grid.Column="2" Classes="card" Padding="0">
                <ScrollViewer Name="TopicScroller" Padding="24,20">
                    <controls:MarkdownView DrawsAtOnce="True"
                                           Markdown="{Binding Current.Markdown}"
                                           HighlightWords="{Binding HighlightWords}"
                                           LinkClicked="OnLinkClicked" />
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>

</Window>
