<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Settings.Resources"
             xmlns:vm="using:Joktan.Settings.ViewModels"
             xmlns:views="using:Joktan.Settings.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="736"
             x:Class="Joktan.Settings.Views.ThemesView"
             x:DataType="vm:ThemesViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <views:ThemeBar DockPanel.Dock="Top" DataContext="{Binding Bar}" />

        <ScrollViewer>
            <Border Classes="card" Margin="24" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Classes="card-title" Text="{x:Static res:Strings.ThemesView_ChooseATheme}" />
                    <TextBlock Classes="card-subtitle"
                               Text="{x:Static res:Strings.ThemesView_AThemeHoldsAllTheColours}" />
                    <ItemsControl ItemsSource="{Binding Rows}" IsEnabled="{Binding CanChoose}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThemeRowViewModel">
                                <Border Classes="table-row">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                        <RadioButton GroupName="Theme" Content="{Binding DisplayName}" IsChecked="{Binding IsCurrent}" />
                                        <TextBlock Grid.Column="1" Classes="info-label" VerticalAlignment="Center" Text="{Binding Kind}" />
                                        <Button Grid.Column="2" Classes="small" Width="64"
                                                Content="{x:Static res:Strings.ThemesView_Delete}"
                                                IsEnabled="{Binding CanDelete}"
                                                Command="{Binding DeleteCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>

</UserControl>
