<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Settings.Resources"
             xmlns:vm="using:Joktan.Settings.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="736"
             x:Class="Joktan.Settings.Views.SearchSettingsView"
             x:DataType="vm:SearchSettingsViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <Border Classes="card" Margin="24" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Classes="card-title" Text="{x:Static res:Strings.SearchSettingsView_Search}" />
                    <TextBlock Classes="card-subtitle"
                               Text="{x:Static res:Strings.SearchSettingsView_ChooseWhatTheSearchBoxIn}" />

                    <Border Classes="table-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="table-cell" Text="{x:Static res:Strings.SearchSettingsView_Notes}" />
                            <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Notes}"
                                          ToolTip.Tip="{x:Static res:Strings.SearchSettingsView_SearchTheTitlesAndTextOf}" />
                        </Grid>
                    </Border>
                    <Border Classes="table-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="table-cell" Text="{x:Static res:Strings.SearchSettingsView_Help}" />
                            <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Help}"
                                          ToolTip.Tip="{x:Static res:Strings.SearchSettingsView_SearchTheHelpTopics}" />
                        </Grid>
                    </Border>
                    <Border Classes="table-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="table-cell" Text="{x:Static res:Strings.SearchSettingsView_Messages}" />
                            <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Messages}"
                                          ToolTip.Tip="{x:Static res:Strings.SearchSettingsView_SearchTheMessagesKeptOnThis}" />
                        </Grid>
                    </Border>
                    <Border Classes="table-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="table-cell" Text="{x:Static res:Strings.SearchSettingsView_Alerts}" />
                            <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Alerts}"
                                          ToolTip.Tip="{x:Static res:Strings.SearchSettingsView_SearchTheAlertsKeptOnThis}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>

</UserControl>
