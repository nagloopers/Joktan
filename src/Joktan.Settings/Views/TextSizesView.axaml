<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Settings.Resources"
             xmlns:vm="using:Joktan.Settings.ViewModels"
             xmlns:views="using:Joktan.Settings.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="736"
             x:Class="Joktan.Settings.Views.TextSizesView"
             x:DataType="vm:TextSizesViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <views:ThemeBar DockPanel.Dock="Top" DataContext="{Binding Bar}" />

        <ScrollViewer>
            <ItemsControl Margin="24" ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="24" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TextSizeGroupViewModel">
                        <Border Classes="card">
                            <StackPanel>
                                <TextBlock Classes="card-title" Margin="0,0,0,8" Text="{Binding Name}" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TextSizeRowViewModel">
                                            <Border Classes="table-row">
                                                <Grid ColumnDefinitions="220,130,*" ColumnSpacing="12">
                                                    <TextBlock Classes="table-cell" Text="{Binding Label}" />
                                                    <NumericUpDown Grid.Column="1"
                                                                   VerticalAlignment="Center"
                                                                   Minimum="{Binding MinSize}"
                                                                   Maximum="{Binding MaxSize}"
                                                                   Increment="1"
                                                                   FormatString="0.#"
                                                                   Value="{Binding Size}" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                               FontSize="{Binding SampleSize}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{x:Static res:Strings.TextSizesView_SampleText}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

</UserControl>
