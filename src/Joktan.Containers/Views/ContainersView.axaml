<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Containers.Resources"
             xmlns:vm="using:Joktan.Containers.ViewModels"
             xmlns:containers="using:Joktan.Containers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="900"
             x:Class="Joktan.Containers.Views.ContainersView"
             x:DataType="vm:ContainersViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" />
                <TextBlock Classes="info-label" VerticalAlignment="Center">
                    <Run Text="{Binding Activity}" />
                    <Run Text="…" />
                </TextBlock>
                <Button Classes="small" Content="{x:Static res:Strings.ContainersView_Cancel}" Command="{Binding CancelCommand}"
                        ToolTip.Tip="{x:Static res:Strings.ContainersView_StopTheCommandContainersItAlready}" />
            </StackPanel>
            <TextBlock Classes="error" TextWrapping="Wrap"
                       Text="{Binding Error}"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <!-- The rows change with the logs: see ApplyLogPanel -->
        <Grid x:Name="Body" Margin="24,16,24,24" RowDefinitions="Auto,16,*">

            <Grid ColumnDefinitions="3*,16,2*">
                <!-- Each file's services and their containers -->
                <Border Classes="card">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="card-title" Text="{x:Static res:Strings.ContainersView_Services}" />
                                <TextBlock Classes="card-subtitle" Text="{Binding Summary}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.ContainersView_Refresh}" VerticalAlignment="Top"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.ContainersView_CheckTheContainersNowAndLook}" />
                        </Grid>

                        <TextBlock DockPanel.Dock="Top" Classes="info-label" Margin="0,8,0,0" TextWrapping="Wrap" IsVisible="{Binding !HasProjects}"
                                   Text="{x:Static res:Strings.ContainersView_NoComposeFilesYetAddOne}" />

                        <Grid DockPanel.Dock="Top" ColumnDefinitions="150,1.1*,*,100,150" ColumnSpacing="12" Margin="0,8,0,10" IsVisible="{Binding HasProjects}">
                            <TextBlock Classes="table-header" Text="{x:Static res:Strings.ContainersView_Service}" />
                            <TextBlock Grid.Column="1" Classes="table-header" Text="{x:Static res:Strings.ContainersView_Container}" />
                            <TextBlock Grid.Column="2" Classes="table-header" Text="{x:Static res:Strings.ContainersView_Status}" />
                            <TextBlock Grid.Column="3" Classes="table-header" Text="{x:Static res:Strings.ContainersView_Ports}" />
                        </Grid>
                        <ScrollViewer x:Name="ServicesScroll">
                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ComposeProjectViewModel">
                                        <StackPanel Spacing="4" Margin="0,4,0,8">
                                            <!-- The file, and commands for all its services -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <Button Classes="small" Content="{Binding ExpandText}" Command="{Binding ToggleExpandedCommand}"
                                                        VerticalAlignment="Center" ToolTip.Tip="{x:Static res:Strings.ContainersView_ShowOrHideItsServices}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="table-cell" FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Classes="info-label" FontSize="{DynamicResource TinyFontSize}" TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Details}" ToolTip.Tip="{Binding File}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button Classes="small accent" Content="{x:Static res:Strings.ContainersView_Start}" Command="{Binding UpCommand}"
                                                            ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeUpDCreateTheContainers}" />
                                                    <Button Classes="small" Content="{x:Static res:Strings.ContainersView_Stop}" Command="{Binding StopCommand}"
                                                            ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeStopStopTheContainersAnd}" />
                                                    <Button Classes="small" Content="{x:Static res:Strings.ContainersView_Restart}" Command="{Binding RestartCommand}"
                                                            ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeRestartStopAndStartThe}" />
                                                    <Button Classes="small" Content="{x:Static res:Strings.ContainersView_Down}" Command="{Binding DownCommand}"
                                                            ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeDownStopAndRemoveThe}" />
                                                    <Button Classes="small" Content="{x:Static res:Strings.ContainersView_More}" ToolTip.Tip="{x:Static res:Strings.ContainersView_MoreCommandsForEveryServiceIn}">
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_Recreate}" Command="{Binding RecreateCommand}"
                                                                          ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeUpDForceRecreateMake}" />
                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_RebuildAndStart}" Command="{Binding RebuildCommand}"
                                                                          ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeUpDBuildBuildThe}" />
                                                                <Separator />
                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_PullImages}" Command="{Binding PullCommand}"
                                                                          ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposePullIgnoreBuildableFetchThe}" />
                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_BuildImages}" Command="{Binding BuildCommand}"
                                                                          ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeBuildBuildTheImagesWithout}" />
                                                                <Separator />
                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_Pause}" Command="{Binding PauseCommand}" ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposePauseFreezeTheRunningContainers}" />
                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_Resume}" Command="{Binding UnpauseCommand}" ToolTip.Tip="{x:Static res:Strings.ContainersView_UnpauseLetThePausedContainersRun}" />
                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_Kill}" Command="{Binding KillCommand}" ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeKillStopTheContainersAt}" />
                                                                <Separator />
                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_DownAndRemoveVolumes}" Command="{Binding DownWithVolumesCommand}"
                                                                          ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeDownVolumesAsDownAnd}" />
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding NameWarning}"
                                                       IsVisible="{Binding NameWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}"
                                                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                            <!-- Down with volumes, once confirmed -->
                                            <Border Classes="group-row" Padding="12" IsVisible="{Binding IsConfirmingDownWithVolumes}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <TextBlock Classes="table-cell" TextWrapping="Wrap" Text="{Binding DownWithVolumesText}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Content="{x:Static res:Strings.ContainersView_Cancel}" Command="{Binding CancelDownWithVolumesCommand}" />
                                                        <Button Classes="accent" Content="{x:Static res:Strings.ContainersView_DeleteVolumes}" Command="{Binding ConfirmDownWithVolumesCommand}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Services}" IsVisible="{Binding IsExpanded}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ComposeServiceRow">
                                                        <Border Classes="table-row">
                                                            <Grid ColumnDefinitions="150,1.1*,*,100,150" ColumnSpacing="12">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Ellipse Classes="state-dot"
                                                                             Classes.ok="{Binding IsRunning}"
                                                                             Classes.pending="{Binding IsPaused}"
                                                                             Classes.failed="{Binding IsStopped}" />
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Classes="table-cell" FontWeight="SemiBold" Text="{Binding Service}" />
                                                                        <TextBlock Classes="info-label" FontSize="{DynamicResource TinyFontSize}" TextTrimming="CharacterEllipsis" MaxWidth="130"
                                                                                   Text="{Binding Image}" ToolTip.Tip="{Binding Image}"
                                                                                   IsVisible="{Binding Image, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Classes="table-cell" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                                                <TextBlock Grid.Column="2" Classes="table-cell" Text="{Binding Status}" ToolTip.Tip="{Binding Status}" />
                                                                <TextBlock Grid.Column="3" Classes="table-cell" Text="{Binding Ports}" ToolTip.Tip="{Binding Ports}" />
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                                    <Button Classes="small" Content="{x:Static res:Strings.ContainersView_Start}"
                                                                            IsVisible="{Binding CanStart}"
                                                                            Command="{Binding Project.UpCommand}"
                                                                            CommandParameter="{Binding Service}"
                                                                            ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeUpDForThisService}" />
                                                                    <Button Classes="small" Content="{x:Static res:Strings.ContainersView_Resume}"
                                                                            IsVisible="{Binding IsPaused}"
                                                                            Command="{Binding Project.UnpauseCommand}"
                                                                            CommandParameter="{Binding Service}"
                                                                            ToolTip.Tip="{x:Static res:Strings.ContainersView_UnpauseLetItRunAgain}" />
                                                                    <Button Classes="small" Content="{x:Static res:Strings.ContainersView_Stop}"
                                                                            IsVisible="{Binding IsRunning}"
                                                                            Command="{Binding Project.StopCommand}"
                                                                            CommandParameter="{Binding Service}"
                                                                            ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeStopForThisService}" />
                                                                    <Button Classes="small" Content="{x:Static res:Strings.ContainersView_Restart}"
                                                                            IsVisible="{Binding IsRunning}"
                                                                            Command="{Binding Project.RestartCommand}"
                                                                            CommandParameter="{Binding Service}"
                                                                            ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeRestartForThisService}" />
                                                                    <Button Classes="small" Content="⋯" ToolTip.Tip="{x:Static res:Strings.ContainersView_MoreForThisService}">
                                                                        <Button.Flyout>
                                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_ShowItsLogs}" Command="{Binding Project.ShowServiceLogsCommand}" CommandParameter="{Binding Service}" />
                                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_OpenAShellInATerminal}" Command="{Binding Project.OpenShellCommand}" CommandParameter="{Binding Service}"
                                                                                          IsEnabled="{Binding IsRunning}"
                                                                                          ToolTip.Tip="{x:Static res:Strings.ContainersView_ExecItWithShInsideThe}" />
                                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_CopyTheContainerName}" Click="OnCopyContainerNameClick" IsEnabled="{Binding HasContainer}" />
                                                                                <Separator />
                                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_Recreate}" Command="{Binding Project.RecreateCommand}" CommandParameter="{Binding Service}"
                                                                                          ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeUpDForceRecreateA}" />
                                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_RebuildAndStart}" Command="{Binding Project.RebuildCommand}" CommandParameter="{Binding Service}"
                                                                                          ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeUpDBuildBuildIts}" />
                                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_PullImage}" Command="{Binding Project.PullCommand}" CommandParameter="{Binding Service}"
                                                                                          ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposePullIgnoreBuildableFetchTheLatest}" />
                                                                                <Separator />
                                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_Pause}" Command="{Binding Project.PauseCommand}" CommandParameter="{Binding Service}"
                                                                                          IsVisible="{Binding IsRunning}" ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposePauseFreezeIt}" />
                                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_Resume}" Command="{Binding Project.UnpauseCommand}" CommandParameter="{Binding Service}"
                                                                                          IsVisible="{Binding IsPaused}" ToolTip.Tip="{x:Static res:Strings.ContainersView_UnpauseLetItRunAgain}" />
                                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_Kill}" Command="{Binding Project.KillCommand}" CommandParameter="{Binding Service}"
                                                                                          IsVisible="{Binding IsRunning}" ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeKillStopItAtOnce}" />
                                                                                <MenuItem Header="{x:Static res:Strings.ContainersView_RemoveContainer}" Command="{Binding Project.RemoveContainerCommand}" CommandParameter="{Binding Service}"
                                                                                          IsVisible="{Binding HasContainer}" ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeRmStopForceStopAnd}" />
                                                                            </MenuFlyout>
                                                                        </Button.Flyout>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Compose files and engine -->
                <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Classes="card-title" Text="{x:Static res:Strings.ContainersView_ComposeFiles}" />
                            <TextBlock Classes="card-subtitle"
                                       Text="{x:Static res:Strings.ContainersView_EachFileIsItsOwnProject}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ComposeProjectViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                            <TextBlock Classes="code" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding File}" ToolTip.Tip="{Binding File}" />
                                            <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.ContainersView_Remove}" Command="{Binding RemoveCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.ContainersView_StopShowingThisFileItsContainers}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox Classes="code" Text="{Binding NewComposeFile}" PlaceholderText="{x:Static res:Strings.ContainersView_PathOfAComposeFile}" />
                                <Button Grid.Column="1" Content="{x:Static res:Strings.ContainersView_Add}" Command="{Binding AddTypedCommand}" />
                                <Button Grid.Column="2" Content="{x:Static res:Strings.ContainersView_Browse}" Command="{Binding BrowseCommand}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.ContainersView_Engine}" />
                            <ComboBox ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="{x:Static res:Strings.ContainersView_AutoUsesDockerWhenItsEngine}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="containers:ContainerEngine">
                                        <TextBlock Text="{Binding Converter={x:Static containers:ContainerEngineText.ContainerEngineConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="{Binding EngineText}"
                                       IsVisible="{Binding EngineText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Logs and command output -->
            <Border Grid.Row="2" Classes="card" Padding="0">
                <Panel>
                <!-- Collapsed, all that is left of them -->
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="16,8" IsVisible="{Binding !IsLogPanelOpen}">
                    <Button Classes="small" Content="▸" Command="{Binding ToggleLogPanelCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static res:Strings.ContainersView_ShowTheLogsAndCommandOutput}" />
                    <TextBlock Grid.Column="1" Classes="table-cell" FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static res:Strings.ContainersView_LogsAndCommandOutput}" />
                    <TextBlock Grid.Column="2" Classes="info-label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="{x:Static res:Strings.ContainersView_TheLogsKeepComingWhileCollapsed}"
                               IsVisible="{Binding IsFollowingLogs}" />
                </Grid>
                <Button Classes="small" Content="▾" Command="{Binding ToggleLogPanelCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,16,0" ZIndex="1"
                        IsVisible="{Binding IsLogPanelOpen}"
                        ToolTip.Tip="{x:Static res:Strings.ContainersView_CollapseTheLogsAndCommandOutput}" />
                <TabControl Name="BottomTabs" Padding="16,8,16,16" IsVisible="{Binding IsLogPanelOpen}">
                    <TabControl.Styles>
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="{DynamicResource TabFontSize}" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="16,0" />
                        </Style>
                    </TabControl.Styles>
                    <TabItem Header="{x:Static res:Strings.ContainersView_Logs}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,8,0,8">
                                <Button Classes="accent" Content="{Binding LogsButtonText}" Command="{Binding ToggleLogsCommand}" MinWidth="96"
                                        ToolTip.Tip="{x:Static res:Strings.ContainersView_ComposeLogsFollowShowWhatThe}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding LogChoices}" SelectedItem="{Binding SelectedLog}" MinWidth="220"
                                          ToolTip.Tip="{x:Static res:Strings.ContainersView_WhoseLogsToShowOneFile}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ComposeLogChoice">
                                            <TextBlock>
                                                <Run Text="{Binding Project.Name}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding ServiceText}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Classes="info-label" VerticalAlignment="Center" Text="{x:Static res:Strings.ContainersView_Last}" />
                                    <NumericUpDown Value="{Binding TailLines}" Minimum="0" Maximum="5000" Increment="100" FormatString="0" Width="120"
                                                   ToolTip.Tip="{x:Static res:Strings.ContainersView_HowManyEarlierLinesOfEach}" />
                                    <TextBlock Classes="info-label" VerticalAlignment="Center" Text="{x:Static res:Strings.ContainersView_Lines}" />
                                </StackPanel>
                                <CheckBox Grid.Column="3" Content="{x:Static res:Strings.ContainersView_Timestamps}" IsChecked="{Binding ShowTimestamps}" />
                                <CheckBox Grid.Column="5" Content="{x:Static res:Strings.ContainersView_KeepNewestInView}" IsChecked="{Binding AutoScroll}" />
                                <Button Grid.Column="6" Classes="small" Content="{x:Static res:Strings.ContainersView_Copy}" Click="OnCopyLogsClick" VerticalAlignment="Center"
                                        ToolTip.Tip="{x:Static res:Strings.ContainersView_CopyTheLinesShown}" />
                                <Button Grid.Column="7" Classes="small" Content="{x:Static res:Strings.ContainersView_Clear}" Command="{Binding ClearLogsCommand}" VerticalAlignment="Center" />
                            </Grid>
                            <ListBox x:Name="LogList" Classes="log console" ItemsSource="{Binding LogLines}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="code" Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{x:Static res:Strings.ContainersView_CommandOutput}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,8,0,8">
                                <TextBlock Classes="info-label" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.ContainersView_WhatStartStopRestartAndDown}" />
                                <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.ContainersView_Copy}" Click="OnCopyOutputClick" />
                                <Button Grid.Column="2" Classes="small" Content="{x:Static res:Strings.ContainersView_Clear}" Command="{Binding ClearOutputCommand}" />
                            </Grid>
                            <ListBox x:Name="OutputList" Classes="log console" ItemsSource="{Binding Output}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="code" Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
                </Panel>
            </Border>
        </Grid>
    </DockPanel>

</UserControl>
