<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Api.Resources"
             xmlns:vm="using:Joktan.Api.ViewModels"
             xmlns:api="using:Joktan.Api"
             xmlns:core="using:Joktan.Core"
             xmlns:controls="using:Joktan.Api.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="860"
             x:Class="Joktan.Api.Views.ApiClientView"
             x:DataType="vm:ApiClientViewModel">

    <UserControl.Resources>
        <!-- A row of a header, parameter, metadata or variable list -->
        <DataTemplate x:Key="PairRow" x:DataType="vm:ApiPairViewModel">
            <Grid ColumnDefinitions="Auto,*,2*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" ToolTip.Tip="{x:Static res:Strings.ApiClientView_SendIt}" />
                <TextBox Grid.Column="1" Classes="code" Text="{Binding Name}" PlaceholderText="{x:Static res:Strings.ApiClientView_Name}" />
                <TextBox Grid.Column="2" Classes="code" Text="{Binding Value}" PlaceholderText="{x:Static res:Strings.ApiClientView_Value}" />
                <Button Grid.Column="3" Classes="small" Content="{x:Static res:Strings.ApiClientView_Remove}" Command="{Binding RemoveCommand}" />
            </Grid>
        </DataTemplate>
        <!-- A variable to save from the response -->
        <DataTemplate x:Key="CaptureRow" x:DataType="vm:ApiPairViewModel">
            <Grid ColumnDefinitions="Auto,*,2*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" ToolTip.Tip="{x:Static res:Strings.ApiClientView_SaveIt}" />
                <TextBox Grid.Column="1" Classes="code" Text="{Binding Name}" PlaceholderText="{x:Static res:Strings.ApiClientView_VariableSuchAsToken}" />
                <TextBox Grid.Column="2" Classes="code" Text="{Binding Value}" PlaceholderText="{x:Static res:Strings.ApiClientView_PathInTheBodySuchAs}" />
                <Button Grid.Column="3" Classes="small" Content="{x:Static res:Strings.ApiClientView_Remove}" Command="{Binding RemoveCommand}" />
            </Grid>
        </DataTemplate>
        <!-- The request as last sent, on both kinds of request -->
        <DataTemplate x:Key="LastSentView" x:DataType="vm:ApiRequestViewModel">
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Top" Classes="info-label" Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding LastSentTime}"
                           IsVisible="{Binding HasLastSent}" />
                <Panel>
                    <TextBlock Classes="info-label" TextWrapping="Wrap" IsVisible="{Binding !HasLastSent}"
                               Text="{x:Static res:Strings.ApiClientView_NothingHasBeenSentFromThis}" />
                    <TextBox Classes="code response" IsReadOnly="True" Text="{Binding LastSentText, Mode=OneWay}" IsVisible="{Binding HasLastSent}" />
                </Panel>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="PathRow" x:DataType="vm:ApiPathViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <TextBlock Classes="code" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Path}"
                           ToolTip.Tip="{Binding Path}" />
                <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.ApiClientView_Remove}" Command="{Binding RemoveCommand}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="HeaderRow" x:DataType="api:ApiPair">
            <Border Classes="info-row">
                <Grid ColumnDefinitions="220,*" ColumnSpacing="8">
                    <SelectableTextBlock Classes="info-value code" Margin="0" Text="{Binding Name}" />
                    <SelectableTextBlock Grid.Column="1" Classes="info-value code" Margin="0" TextWrapping="Wrap" Text="{Binding Value}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="{DynamicResource TabFontSize}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0,0,20,0" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
                    <TextBlock Classes="page-title" Text="{Binding Title}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
                </StackPanel>
                <!-- Wraps onto another line when the window is narrow -->
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" ItemSpacing="8" LineSpacing="8">
                    <ComboBox ItemsSource="{Binding EnvironmentChoices}" SelectedItem="{Binding SelectedEnvironment}" MinWidth="170"
                              ToolTip.Tip="{x:Static res:Strings.ApiClientView_WhoseVariablesAreFilledInWhen}" />
                    <Button Content="{x:Static res:Strings.ApiClientView_Environments}" Command="{Binding ToggleEnvironmentsCommand}"
                            ToolTip.Tip="{x:Static res:Strings.ApiClientView_SetsOfVariablesSuchAsOne}" />
                    <Button Content="{x:Static res:Strings.ApiClientView_Folder}" Command="{Binding ToggleWorkspaceCommand}"
                            ToolTip.Tip="{x:Static res:Strings.ApiClientView_ChooseTheFolderTheRequestsAre}" />
                    <Button Content="{x:Static res:Strings.ApiClientView_NewFolder}" Command="{Binding NewFolderCommand}" />
                    <Button Content="{x:Static res:Strings.ApiClientView_NewGRPC}" Command="{Binding NewGrpcRequestCommand}" ToolTip.Tip="{x:Static res:Strings.ApiClientView_AddAGRPCRequest}" />
                    <Button Classes="accent" Content="{x:Static res:Strings.ApiClientView_NewREST}" Command="{Binding NewRestRequestCommand}" ToolTip.Tip="{x:Static res:Strings.ApiClientView_AddARESTRequest}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Where the requests are kept -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="24,16,24,0" IsVisible="{Binding IsChoosingWorkspace}">
            <StackPanel Spacing="8">
                <TextBlock Classes="card-title" Text="{x:Static res:Strings.ApiClientView_RequestsFolder}" />
                <TextBlock Classes="card-subtitle" Margin="0"
                           Text="{x:Static res:Strings.ApiClientView_EachRequestIsARequestJson}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Classes="code" Text="{Binding WorkspaceText}" PlaceholderText="{Binding DefaultFolder}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Static res:Strings.ApiClientView_Browse}" Command="{Binding BrowseWorkspaceCommand}" />
                        <Button Content="{x:Static res:Strings.ApiClientView_Default}" Command="{Binding UseDefaultWorkspaceCommand}" />
                        <Button Content="{x:Static res:Strings.ApiClientView_Cancel}" Command="{Binding ToggleWorkspaceCommand}" />
                        <Button Classes="accent" Content="{x:Static res:Strings.ApiClientView_UseFolder}" Command="{Binding ApplyWorkspaceCommand}" />
                    </StackPanel>
                </Grid>
                <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding WorkspaceMessage}"
                           IsVisible="{Binding WorkspaceMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>

        <!-- Environments and their variables -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="24,16,24,0" IsVisible="{Binding IsEditingEnvironments}">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.ApiClientView_Environments}" />
                        <TextBlock Classes="card-subtitle" Margin="0,6,0,0"
                                   Text="{x:Static res:Strings.ApiClientView_WriteNameInAnAddressHeader}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Content="{x:Static res:Strings.ApiClientView_NewEnvironment}" Command="{Binding NewEnvironmentCommand}" />
                        <Button Content="{x:Static res:Strings.ApiClientView_Close}" Command="{Binding ToggleEnvironmentsCommand}" />
                    </StackPanel>
                </Grid>
                <TextBlock Classes="info-label" Text="{x:Static res:Strings.ApiClientView_NoEnvironmentsYet}" IsVisible="{Binding !HasEnvironments}" />
                <Grid ColumnDefinitions="200,16,*" IsVisible="{Binding HasEnvironments}">
                    <ListBox ItemsSource="{Binding Environments}" SelectedItem="{Binding EditedEnvironment}" Classes="log" MaxHeight="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ApiEnvironmentViewModel">
                                <TextBlock Classes="table-cell" Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="2" Spacing="8" DataContext="{Binding $parent[UserControl].((vm:ApiClientViewModel)DataContext).EditedEnvironment}" x:DataType="vm:ApiEnvironmentViewModel"
                                IsVisible="{Binding $parent[UserControl].((vm:ApiClientViewModel)DataContext).EditedEnvironment, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding Name}" PlaceholderText="{x:Static res:Strings.ApiClientView_Name}" />
                            <Button Grid.Column="1" Content="{x:Static res:Strings.ApiClientView_DeleteEnvironment}"
                                    Command="{Binding $parent[UserControl].((vm:ApiClientViewModel)DataContext).DeleteEnvironmentCommand}" />
                        </Grid>
                        <ScrollViewer MaxHeight="200">
                            <ItemsControl ItemsSource="{Binding Variables}" ItemTemplate="{StaticResource PairRow}" />
                        </ScrollViewer>
                        <Button Classes="small" Content="{x:Static res:Strings.ApiClientView_AddVariable}" Command="{Binding Variables.AddCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Classes="error" Margin="24,12,24,0" TextWrapping="Wrap" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock DockPanel.Dock="Top" Classes="info-label" Margin="24,12,24,0" TextWrapping="Wrap" Text="{Binding Message}"
                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Grid Margin="24" ColumnDefinitions="280,16,*">

            <!-- Folders and requests -->
            <Border Classes="card" Padding="8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,8,4,8" ColumnDefinitions="*,Auto">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.ApiClientView_Requests}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.ApiClientView_Reload}" Command="{Binding RefreshCommand}"
                                ToolTip.Tip="{x:Static res:Strings.ApiClientView_ReadTheFolderAgainAfterFiles}" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Classes="info-label" Margin="12,8" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource TinyFontSize}" Text="{Binding Folder}" ToolTip.Tip="{Binding Folder}" />
                    <Panel>
                        <TextBlock Classes="info-label" Margin="12" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
                                   Text="{x:Static res:Strings.ApiClientView_NoRequestsYetAddOneWith}" />
                        <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding TreeSelection}">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem" x:DataType="vm:ApiNodeViewModel">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="vm:ApiNodeViewModel" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Classes="node-icon" Data="{x:Static core:Icons.Folder}" IsVisible="{Binding IsFolder}" />
                                        <TextBlock Classes="method" controls:MethodColor.Method="{Binding Method}" Text="{Binding Badge}" IsVisible="{Binding IsRequest}" />
                                        <TextBlock Classes="table-cell" Text="{Binding Name}" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Panel>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Classes="card" VerticalAlignment="Top" IsVisible="{Binding !HasSelection}">
                <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.ApiClientView_SelectARequestToEditAnd}" />
            </Border>

            <Grid Grid.Column="2" RowDefinitions="Auto,*" IsVisible="{Binding HasSelection}">

                <!-- Name, folder and delete, for a request or a folder -->
                <Border Classes="card" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,220,Auto" ColumnSpacing="8">
                            <TextBox x:Name="NameBox" Text="{Binding EditName}" PlaceholderText="{x:Static res:Strings.ApiClientView_Name}"
                                     ToolTip.Tip="{x:Static res:Strings.ApiClientView_RenamesTheFileOrFolderWhen}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding EditFolder}" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="{x:Static res:Strings.ApiClientView_TheFolderItIsInChoose}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="{x:Static res:Strings.ApiClientView_Duplicate}" Command="{Binding DuplicateCommand}" IsVisible="{Binding !IsFolderSelected}" />
                                <Button Content="{x:Static res:Strings.ApiClientView_Delete}" Command="{Binding DeleteCommand}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="info-label" Text="{Binding FolderSummary}" IsVisible="{Binding IsFolderSelected}" />
                        <Border Classes="group-row" Padding="12" IsVisible="{Binding IsConfirmingDelete}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Classes="table-cell" TextWrapping="Wrap" Text="{Binding DeleteText}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="{x:Static res:Strings.ApiClientView_Cancel}" Command="{Binding CancelDeleteCommand}" />
                                    <Button Classes="accent" Content="{x:Static res:Strings.ApiClientView_Delete}" Command="{Binding ConfirmDeleteCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- The request and its response -->
                <Grid Grid.Row="1" RowDefinitions="*,8,*" DataContext="{Binding $parent[UserControl].((vm:ApiClientViewModel)DataContext).Request}" x:DataType="vm:ApiRequestViewModel"
                      IsVisible="{Binding $parent[UserControl].((vm:ApiClientViewModel)DataContext).HasRequest}">

                    <Border Classes="card" Padding="16">
                        <DockPanel>
                            <!-- REST: method, address, send -->
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="110,*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsRest}">
                                <ComboBox ItemsSource="{Binding MethodChoices}" SelectedItem="{Binding Method}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Classes="method choice" controls:MethodColor.Method="{Binding}" Text="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Grid.Column="1" Classes="code" Text="{Binding Url}" PlaceholderText="https://api.example.com/items or {{baseUrl}}/items" />
                                <Panel Grid.Column="2">
                                    <Button Classes="accent" Content="{x:Static res:Strings.ApiClientView_Send}" Command="{Binding SendCommand}" IsVisible="{Binding IsNotSending}" MinWidth="80" />
                                    <Button Content="{x:Static res:Strings.ApiClientView_Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsSending}" MinWidth="80" />
                                </Panel>
                                <Button Grid.Column="3" Content="{x:Static res:Strings.ApiClientView_Resend}" Command="{Binding ResendCommand}" IsVisible="{Binding CanResend}"
                                        ToolTip.Tip="{x:Static res:Strings.ApiClientView_SendTheLastRequestAgainAs}" />
                            </Grid>

                            <!-- gRPC: address, send, service and method -->
                            <StackPanel DockPanel.Dock="Top" Spacing="8" IsVisible="{Binding IsGrpc}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Classes="code" Text="{Binding Address}" PlaceholderText="{x:Static res:Strings.ApiClientView_HttpsLocalhost5001OrHttpLocalhost}" />
                                    <Panel Grid.Column="1">
                                        <Button Classes="accent" Content="{x:Static res:Strings.ApiClientView_Send}" Command="{Binding SendCommand}" IsVisible="{Binding IsNotSending}" MinWidth="80" />
                                        <Button Content="{x:Static res:Strings.ApiClientView_Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsSending}" MinWidth="80" />
                                    </Panel>
                                    <Button Grid.Column="2" Content="{x:Static res:Strings.ApiClientView_Resend}" Command="{Binding ResendCommand}" IsVisible="{Binding CanResend}"
                                            ToolTip.Tip="{x:Static res:Strings.ApiClientView_SendTheLastMessageAgainAs}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                    <ComboBox ItemsSource="{Binding Services}" SelectedItem="{Binding ServiceChoice}" HorizontalAlignment="Stretch"
                                              PlaceholderText="{x:Static res:Strings.ApiClientView_Service}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Methods}" SelectedItem="{Binding RpcChoice}" HorizontalAlignment="Stretch"
                                              PlaceholderText="{x:Static res:Strings.ApiClientView_Method}" />
                                    <Button Grid.Column="2" Content="{x:Static res:Strings.ApiClientView_LoadServices}" Command="{Binding LoadServicesCommand}"
                                            ToolTip.Tip="{x:Static res:Strings.ApiClientView_AskTheServerOrReadThe}" />
                                </Grid>
                                <TextBlock Classes="info-label" TextWrapping="Wrap">
                                    <Run Text="{Binding MethodText}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding SchemaStatus}" />
                                </TextBlock>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Top" Classes="error" TextWrapping="Wrap" Text="{Binding Error}"
                                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <!-- REST tabs -->
                            <TabControl Margin="0,8,0,0" IsVisible="{Binding IsRest}">
                                <TabItem Header="{x:Static res:Strings.ApiClientView_Params}">
                                    <ScrollViewer>
                                        <StackPanel Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Query}" ItemTemplate="{StaticResource PairRow}" />
                                            <Button Classes="small" Content="{x:Static res:Strings.ApiClientView_AddParameter}" Command="{Binding Query.AddCommand}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{x:Static res:Strings.ApiClientView_Headers}">
                                    <ScrollViewer>
                                        <StackPanel Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Headers}" ItemTemplate="{StaticResource PairRow}" />
                                            <Button Classes="small" Content="{x:Static res:Strings.ApiClientView_AddHeader}" Command="{Binding Headers.AddCommand}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{x:Static res:Strings.ApiClientView_Body}">
                                    <DockPanel Margin="0,8,0,0">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                            <ComboBox ItemsSource="{Binding BodyKinds}" SelectedItem="{Binding BodyKind}" Width="140">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="api:ApiBodyKind">
                                                        <TextBlock Text="{Binding Converter={x:Static api:ApiKindText.ApiBodyKindConverter}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Classes="small" Content="{x:Static res:Strings.ApiClientView_FormatJSON}" Command="{Binding FormatBodyCommand}" VerticalAlignment="Center"
                                                    IsVisible="{Binding IsBodyText}" />
                                        </StackPanel>
                                        <Panel>
                                            <TextBox Classes="code note-editor" Text="{Binding Body}" IsVisible="{Binding IsBodyText}" />
                                            <ScrollViewer IsVisible="{Binding IsBodyForm}">
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Form}" ItemTemplate="{StaticResource PairRow}" />
                                                    <Button Classes="small" Content="{x:Static res:Strings.ApiClientView_AddField}" Command="{Binding Form.AddCommand}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Panel>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="{x:Static res:Strings.ApiClientView_Auth}">
                                    <StackPanel Margin="0,8,0,0" Spacing="12">
                                        <ComboBox ItemsSource="{Binding AuthKinds}" SelectedItem="{Binding AuthKind}" Width="140">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="api:ApiAuthKind">
                                                    <TextBlock Text="{Binding Converter={x:Static api:ApiKindText.ApiAuthKindConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel IsVisible="{Binding IsBearer}">
                                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.ApiClientView_Token}" />
                                            <TextBox Classes="code" Text="{Binding Token}" PlaceholderText="{}{{token}}" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsBasic}">
                                            <StackPanel>
                                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.ApiClientView_Username}" />
                                                <TextBox Text="{Binding Username}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.ApiClientView_Password}" />
                                                <TextBox PasswordChar="•" Text="{Binding Password}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Classes="info-label" TextWrapping="Wrap"
                                                   Text="{x:Static res:Strings.ApiClientView_SavedInTheRequestSFile}" />
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="{x:Static res:Strings.ApiClientView_SaveToVariables}">
                                    <ScrollViewer>
                                        <StackPanel Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Captures}" ItemTemplate="{StaticResource CaptureRow}" />
                                            <Button Classes="small" Content="{x:Static res:Strings.ApiClientView_AddVariable}" Command="{Binding Captures.AddCommand}" />
                                            <TextBlock Classes="info-label" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Text="{x:Static res:Strings.ApiClientView_AfterASuccessfulResponseEachValue}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{x:Static res:Strings.ApiClientView_LastSent}">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LastSentView}" />
                                </TabItem>
                                <TabItem Header="{x:Static res:Strings.ApiClientView_Settings}">
                                    <StackPanel Margin="0,8,0,0" Spacing="12">
                                        <CheckBox Content="{x:Static res:Strings.ApiClientView_AcceptAnyTLSCertificateForLocal}" IsChecked="{Binding AcceptAnyCertificate}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="info-label" Text="{x:Static res:Strings.ApiClientView_GiveUpAfter}" VerticalAlignment="Center" />
                                            <NumericUpDown Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="3600" Increment="5" FormatString="0" Width="120" />
                                            <TextBlock Classes="info-label" Text="{x:Static res:Strings.ApiClientView_Seconds}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>

                            <!-- gRPC tabs -->
                            <TabControl Margin="0,8,0,0" IsVisible="{Binding IsGrpc}">
                                <TabItem Header="{x:Static res:Strings.ApiClientView_Message}">
                                    <DockPanel Margin="0,8,0,0">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                            <Button Classes="small" Content="{x:Static res:Strings.ApiClientView_ExampleMessage}" Command="{Binding TemplateCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.ApiClientView_FillInEveryFieldOfThe}" />
                                            <Button Classes="small" Content="{x:Static res:Strings.ApiClientView_FormatJSON}" Command="{Binding FormatMessageCommand}" />
                                        </StackPanel>
                                        <TextBox Classes="code note-editor" Text="{Binding Message}" />
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="{x:Static res:Strings.ApiClientView_Metadata}">
                                    <ScrollViewer>
                                        <StackPanel Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Metadata}" ItemTemplate="{StaticResource PairRow}" />
                                            <Button Classes="small" Content="{x:Static res:Strings.ApiClientView_AddMetadata}" Command="{Binding Metadata.AddCommand}" />
                                            <TextBlock Classes="info-label" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Text="{x:Static res:Strings.ApiClientView_SuchAsAuthorizationBearerTokenNames}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{x:Static res:Strings.ApiClientView_Schema}">
                                    <ScrollViewer>
                                        <StackPanel Margin="0,8,0,0" Spacing="8">
                                            <RadioButton GroupName="schema" IsChecked="{Binding UsesReflection}"
                                                         Content="{x:Static res:Strings.ApiClientView_AskTheServerGRPCServerReflection}" />
                                            <RadioButton GroupName="schema" IsChecked="{Binding UsesProtoFiles}" Content="{x:Static res:Strings.ApiClientView_ReadProtoFiles}" />
                                            <StackPanel Margin="28,4,0,0" Spacing="6" IsVisible="{Binding UsesProtoFiles}">
                                                <ItemsControl ItemsSource="{Binding ProtoFiles}" ItemTemplate="{StaticResource PathRow}" />
                                                <Button Classes="small" Content="{x:Static res:Strings.ApiClientView_AddProtoFiles}" Command="{Binding AddProtoFilesCommand}" />
                                                <TextBlock Classes="field-label" Margin="0,8,0,4" Text="{x:Static res:Strings.ApiClientView_FoldersToLookForImportsIn}" />
                                                <ItemsControl ItemsSource="{Binding ImportPaths}" ItemTemplate="{StaticResource PathRow}" />
                                                <Button Classes="small" Content="{x:Static res:Strings.ApiClientView_AddImportFolder}" Command="{Binding AddImportPathCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{x:Static res:Strings.ApiClientView_SaveToVariables}">
                                    <ScrollViewer>
                                        <StackPanel Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Captures}" ItemTemplate="{StaticResource CaptureRow}" />
                                            <Button Classes="small" Content="{x:Static res:Strings.ApiClientView_AddVariable}" Command="{Binding Captures.AddCommand}" />
                                            <TextBlock Classes="info-label" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Text="{x:Static res:Strings.ApiClientView_AfterASuccessfulResponseEachValueIs}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{x:Static res:Strings.ApiClientView_LastSent}">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LastSentView}" />
                                </TabItem>
                                <TabItem Header="{x:Static res:Strings.ApiClientView_Settings}">
                                    <StackPanel Margin="0,8,0,0" Spacing="12">
                                        <CheckBox Content="{x:Static res:Strings.ApiClientView_AcceptAnyTLSCertificateForLocal}" IsChecked="{Binding AcceptAnyCertificate}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="info-label" Text="{x:Static res:Strings.ApiClientView_Deadline}" VerticalAlignment="Center" />
                                            <NumericUpDown Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="3600" Increment="5" FormatString="0" Width="120" />
                                            <TextBlock Classes="info-label" Text="{x:Static res:Strings.ApiClientView_Seconds}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="1" Background="Transparent" ResizeDirection="Rows" />

                    <!-- The response -->
                    <Border Grid.Row="2" Classes="card" Padding="16">
                        <Panel>
                            <TextBlock Classes="info-label" Text="{x:Static res:Strings.ApiClientView_SendTheRequestToSeeThe}" IsVisible="{Binding !HasResponse}" />
                            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsSending}" />
                            <DockPanel IsVisible="{Binding HasResponse}">
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                    <Border Classes="status" Classes.ok="{Binding Response.IsSuccess, FallbackValue=False}"
                                            Classes.failed="{Binding Response.IsFailure, FallbackValue=False}">
                                        <SelectableTextBlock Text="{Binding Response.Status, FallbackValue=''}" TextWrapping="Wrap" MaxWidth="600" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Classes="info-label" VerticalAlignment="Center">
                                        <Run Text="{Binding Response.Elapsed, FallbackValue=''}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding Response.Size, FallbackValue=''}" />
                                    </TextBlock>
                                    <Button Grid.Column="2" Classes="small" Content="{x:Static res:Strings.ApiClientView_CopyBody}" Command="{Binding CopyBodyCommand}" />
                                </Grid>
                                <TextBlock DockPanel.Dock="Top" Classes="info-label" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding SavedVariables}"
                                           IsVisible="{Binding SavedVariables, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TabControl Margin="0,8,0,0">
                                    <TabItem Header="{x:Static res:Strings.ApiClientView_Body}">
                                        <TextBox Classes="code response" Margin="0,8,0,0" IsReadOnly="True" Text="{Binding Response.Body, FallbackValue=''}" />
                                    </TabItem>
                                    <TabItem Header="{x:Static res:Strings.ApiClientView_Headers}">
                                        <ScrollViewer>
                                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Response.Headers, FallbackValue={x:Null}}" ItemTemplate="{StaticResource HeaderRow}" />
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="{x:Static res:Strings.ApiClientView_Trailers}" IsVisible="{Binding Response.HasTrailers, FallbackValue=False}">
                                        <ScrollViewer>
                                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Response.Trailers, FallbackValue={x:Null}}" ItemTemplate="{StaticResource HeaderRow}" />
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </Panel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>

</UserControl>
