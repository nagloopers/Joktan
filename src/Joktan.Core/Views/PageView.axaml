<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Core.Resources"
             xmlns:vm="using:Joktan.Core.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="736"
             x:Class="Joktan.Core.Views.PageView"
             x:DataType="vm:PageViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <Border Classes="card" Margin="24" MinHeight="240" VerticalAlignment="Top">
                <TextBlock Text="{x:Static res:Strings.PageView_PageContentGoesHere}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </ScrollViewer>
    </DockPanel>

</UserControl>
