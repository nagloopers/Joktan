<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens. See docs/design.md for what each one is for. These are the Light and Dark
         themes; Joktan.Settings lays the chosen theme over them. -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#241650" />
            <SolidColorBrush x:Key="SidebarActiveBrush" Color="#3B2A80" />
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="#2E1E66" />
            <SolidColorBrush x:Key="SidebarDividerBrush" Color="#392B6E" />
            <SolidColorBrush x:Key="SidebarTextBrush" Color="#B5ACD6" />
            <SolidColorBrush x:Key="SidebarTextActiveBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#E3E7ED" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F4F5F8" />
            <SolidColorBrush x:Key="BorderBrush" Color="#CDD4E0" />
            <SolidColorBrush x:Key="HoverBrush" Color="#EDEFF4" />
            <SolidColorBrush x:Key="TextBrush" Color="#1C273C" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#7987A1" />
            <!-- Graph series, in this order; checked for colour blindness against SurfaceBrush -->
            <SolidColorBrush x:Key="Chart1Brush" Color="#2A78D6" />
            <SolidColorBrush x:Key="Chart2Brush" Color="#EB6834" />
            <SolidColorBrush x:Key="Chart3Brush" Color="#1BAF7A" />
            <SolidColorBrush x:Key="Chart4Brush" Color="#EDA100" />
            <SolidColorBrush x:Key="Chart5Brush" Color="#E87BA4" />
            <SolidColorBrush x:Key="Chart6Brush" Color="#008300" />
            <SolidColorBrush x:Key="Chart7Brush" Color="#6250D6" />
            <SolidColorBrush x:Key="Chart8Brush" Color="#E34948" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1A1238" />
            <SolidColorBrush x:Key="SidebarActiveBrush" Color="#30246A" />
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="#241A4E" />
            <SolidColorBrush x:Key="SidebarDividerBrush" Color="#2B2156" />
            <SolidColorBrush x:Key="SidebarTextBrush" Color="#ACA3CC" />
            <SolidColorBrush x:Key="SidebarTextActiveBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#12151D" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2130" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#171B27" />
            <SolidColorBrush x:Key="BorderBrush" Color="#2C3345" />
            <SolidColorBrush x:Key="HoverBrush" Color="#262C3D" />
            <SolidColorBrush x:Key="TextBrush" Color="#E6E9F0" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#8D97AD" />
            <!-- Graph series, the same hues stepped for the dark surface -->
            <SolidColorBrush x:Key="Chart1Brush" Color="#3987E5" />
            <SolidColorBrush x:Key="Chart2Brush" Color="#D95926" />
            <SolidColorBrush x:Key="Chart3Brush" Color="#199E70" />
            <SolidColorBrush x:Key="Chart4Brush" Color="#C98500" />
            <SolidColorBrush x:Key="Chart5Brush" Color="#D55181" />
            <SolidColorBrush x:Key="Chart6Brush" Color="#008300" />
            <SolidColorBrush x:Key="Chart7Brush" Color="#9085E9" />
            <SolidColorBrush x:Key="Chart8Brush" Color="#E66767" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Same in both variants -->
    <Color x:Key="SystemAccentColor">#5747B5</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#5747B5" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0D8BF2" />
    <SolidColorBrush x:Key="TealBrush" Color="#00C4C4" />
    <SolidColorBrush x:Key="PinkBrush" Color="#F10075" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3BB001" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E0920B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC3545" />
    <SolidColorBrush x:Key="VioletBrush" Color="#9B7BF0" />
    <SolidColorBrush x:Key="SearchMatchBrush" Color="#FFD54A" />
    <SolidColorBrush x:Key="OnSearchMatchBrush" Color="#1C273C" />

    <!-- Meter tracks: the fill colour at low opacity, so the whole bar reads as one state -->
    <SolidColorBrush x:Key="AccentTrackBrush" Color="#5747B5" Opacity="0.18" />
    <SolidColorBrush x:Key="WarningTrackBrush" Color="#E0920B" Opacity="0.22" />
    <SolidColorBrush x:Key="DangerTrackBrush" Color="#DC3545" Opacity="0.2" />

    <!-- Fonts. ContentControlThemeFontFamily is the one Fluent gives every control. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">$Default</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">$Default</FontFamily>
    <FontFamily x:Key="BrandFontFamily">$Default</FontFamily>
    <FontFamily x:Key="MenuFontFamily">$Default</FontFamily>
    <FontFamily x:Key="CodeFontFamily">Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,Liberation Mono,monospace</FontFamily>

    <!-- Text sizes. ControlContentThemeFontSize is the one Fluent gives every control. -->
    <x:Double x:Key="BrandFontSize">26</x:Double>
    <x:Double x:Key="SplashBrandFontSize">34</x:Double>
    <x:Double x:Key="SidebarCaptionFontSize">10</x:Double>
    <x:Double x:Key="MenuFontSize">14</x:Double>
    <x:Double x:Key="SubmenuFontSize">13</x:Double>
    <x:Double x:Key="PageTitleFontSize">24</x:Double>
    <x:Double x:Key="DialogTitleFontSize">18</x:Double>
    <x:Double x:Key="SectionTitleFontSize">16</x:Double>
    <x:Double x:Key="CardTitleFontSize">14</x:Double>
    <x:Double x:Key="TabFontSize">15</x:Double>
    <x:Double x:Key="TileValueFontSize">24</x:Double>
    <x:Double x:Key="NoteTitleFontSize">20</x:Double>
    <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
    <x:Double x:Key="SecondaryFontSize">13</x:Double>
    <x:Double x:Key="SmallFontSize">12</x:Double>
    <x:Double x:Key="TinyFontSize">11</x:Double>
    <x:Double x:Key="CodeFontSize">12</x:Double>
    <x:Double x:Key="InlineCodeFontSize">12.5</x:Double>
    <x:Double x:Key="MethodFontSize">10</x:Double>
    <x:Double x:Key="NoteEditorFontSize">13</x:Double>
    <x:Double x:Key="MarkdownBodyFontSize">14</x:Double>
    <x:Double x:Key="MarkdownH1FontSize">24</x:Double>
    <x:Double x:Key="MarkdownH2FontSize">20</x:Double>
    <x:Double x:Key="MarkdownH3FontSize">17</x:Double>
    <x:Double x:Key="GraphAxisFontSize">11</x:Double>
    <x:Double x:Key="GraphLabelFontSize">12</x:Double>

    <x:Double x:Key="SidebarWidth">240</x:Double>
    <x:Double x:Key="TopBarHeight">64</x:Double>
</ResourceDictionary>
