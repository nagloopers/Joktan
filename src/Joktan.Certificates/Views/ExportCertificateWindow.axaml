<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Joktan.Certificates.Resources"
        xmlns:help="using:Joktan.Core.Controls"
        xmlns:core="using:Joktan.Core"
        xmlns:vm="using:Joktan.Certificates.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="620"
        x:Class="Joktan.Certificates.Views.ExportCertificateWindow"
        core:HelpContext.Topic="certificates"
        x:DataType="vm:ExportCertificateViewModel"
        Width="600" Height="620"
        MinWidth="480" MinHeight="400"
        Icon="avares://Joktan.Core/Assets/joktan.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="{x:Static res:Strings.ExportCertificateWindow_ExportCertificate}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" FontSize="{DynamicResource DialogTitleFontSize}" Text="{x:Static res:Strings.ExportCertificateWindow_ExportCertificate}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Title}" />
                </StackPanel>
                <help:HelpButton Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="topbar" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="error"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,16,0"
                           Text="{Binding Error}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static res:Strings.ExportCertificateWindow_Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Classes="accent" Content="{x:Static res:Strings.ExportCertificateWindow_Export}" Command="{Binding ExportCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.ExportCertificateWindow_Folder}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Classes="code" Text="{Binding Folder}" />
                                <Button Grid.Column="1" Content="{x:Static res:Strings.ExportCertificateWindow_Browse}" Command="{Binding BrowseCommand}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.ExportCertificateWindow_FileName}" />
                            <TextBox Text="{Binding BaseName}" Width="240" HorizontalAlignment="Left" />
                            <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.ExportCertificateWindow_WithoutAnExtensionTheCertificateIs}" />
                        </StackPanel>

                        <CheckBox Content="{x:Static res:Strings.ExportCertificateWindow_PrivateKeyNameKeyNotEncrypted}" IsChecked="{Binding IncludeKey}" IsEnabled="{Binding HasKey}" />
                        <TextBlock Classes="info-label" TextWrapping="Wrap" Margin="28,-6,0,0"
                                   IsVisible="{Binding IsAuthority}"
                                   Text="{x:Static res:Strings.ExportCertificateWindow_ACASKeyIsOnly}" />
                        <CheckBox Content="{x:Static res:Strings.ExportCertificateWindow_CACertificatesCaCrtForA}"
                                  IsChecked="{Binding IncludeAuthority}" IsVisible="{Binding ShowAuthority}" />
                        <CheckBox Content="{x:Static res:Strings.ExportCertificateWindow_PutTheIntermediateCAsAfterThe}"
                                  IsChecked="{Binding IncludeChain}" IsVisible="{Binding ShowChain}"
                                  ToolTip.Tip="{x:Static res:Strings.ExportCertificateWindow_ABrokerShouldShowItsIntermediate}" />

                        <CheckBox Content="{x:Static res:Strings.ExportCertificateWindow_PFXP12FileNameP12With}"
                                  IsChecked="{Binding IncludePkcs12}" IsEnabled="{Binding HasKey}" />
                        <StackPanel IsVisible="{Binding IncludePkcs12}" Margin="28,0,0,0">
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.ExportCertificateWindow_PasswordForThePFXP12File}" />
                            <TextBox Text="{Binding Pkcs12Password}" PasswordChar="•" Width="240" HorizontalAlignment="Left" />
                        </StackPanel>

                        <CheckBox Content="{x:Static res:Strings.ExportCertificateWindow_ReplaceFilesOfTheSameName}" IsChecked="{Binding ReplaceExisting}" />

                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.ExportCertificateWindow_FilesWritten}" />
                            <TextBlock Classes="code" TextWrapping="Wrap" Text="{Binding FilesText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
