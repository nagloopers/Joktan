<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Joktan.Certificates.ViewModels"
             xmlns:certs="using:Joktan.Certificates"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="900"
             x:Class="Joktan.Certificates.Views.CertificatesView"
             x:DataType="vm:CertificatesViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" Text="{Binding Title}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="accent"
                        Content="New root CA"
                        VerticalAlignment="Center"
                        Command="{Binding NewAuthorityCommand}"
                        ToolTip.Tip="Make a certificate authority that signs itself. Select it afterwards to sign server and client certificates with it." />
            </Grid>
        </Border>

        <!-- What happened last -->
        <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0" Spacing="4"
                    IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding Message}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Classes="error" Margin="24,8,24,0" TextWrapping="Wrap"
                   Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Grid Margin="24,16,24,24" ColumnDefinitions="2*,16,3*">

            <!-- Authorities and what they signed -->
            <Border Classes="card" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,8,12,8">
                        <TextBlock Classes="card-title" Text="Authorities and certificates" />
                        <TextBlock Classes="card-subtitle" Margin="0,6,0,0"
                                   Text="Each certificate sits below the CA that signed it." />
                    </StackPanel>
                    <Panel>
                        <TextBlock Classes="info-label"
                                   Margin="12"
                                   TextWrapping="Wrap"
                                   Text="No certificates yet. Start with New root CA, then select it and make a server certificate for the broker and a client certificate for each client."
                                   IsVisible="{Binding IsEmpty}" />
                        <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected}">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem" x:DataType="vm:CertificateNodeViewModel">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                                <!-- Muted text is too faint on the selection colour -->
                                <Style Selector="TreeViewItem:selected TextBlock.info-label">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="vm:CertificateNodeViewModel" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding StatusText}">
                                        <Ellipse Classes="state-dot"
                                                 Classes.ok="{Binding IsValid}"
                                                 Classes.pending="{Binding IsExpiring}"
                                                 Classes.failed="{Binding IsExpired}" />
                                        <TextBlock Classes="table-cell" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Classes="info-label" VerticalAlignment="Center" Text="{Binding Summary}" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Panel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2">
                <StackPanel Spacing="16">

                    <Border Classes="card" IsVisible="{Binding !HasSelection}">
                        <TextBlock Classes="info-label" TextWrapping="Wrap"
                                   Text="Select a CA or certificate to see it, sign more certificates with a CA, or export the files for a broker or client." />
                    </Border>

                    <!-- Selected certificate -->
                    <Border Classes="card" IsVisible="{Binding HasSelection}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="card-title" FontSize="{DynamicResource SectionTitleFontSize}" Text="{Binding Selected.Name}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                        <Ellipse Classes="state-dot"
                                                 Classes.ok="{Binding Selected.IsValid}"
                                                 Classes.pending="{Binding Selected.IsExpiring}"
                                                 Classes.failed="{Binding Selected.IsExpired}" />
                                        <TextBlock Classes="info-label" VerticalAlignment="Center">
                                            <Run Text="{Binding Selected.KindText}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding Selected.StatusText}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                    <Button Content="Export" Command="{Binding ExportCommand}"
                                            ToolTip.Tip="Write the certificate, and its key and CA if wanted, to a folder for a broker or client" />
                                    <Button Content="Delete" Command="{Binding DeleteCommand}"
                                            ToolTip.Tip="Delete it, and everything it signed, with their keys" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Classes="error" TextWrapping="Wrap"
                                       Text="{Binding Selected.Problem}"
                                       IsVisible="{Binding Selected.HasProblem, FallbackValue=False}" />

                            <!-- Delete, once confirmed -->
                            <Border Classes="group-row" Padding="12" IsVisible="{Binding IsConfirmingDelete}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Classes="table-cell" TextWrapping="Wrap" Text="{Binding DeleteText}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
                                        <Button Classes="accent" Content="Delete" Command="{Binding ConfirmDeleteCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Sign more with a CA -->
                            <StackPanel Spacing="8" IsVisible="{Binding Selected.IsAuthority, FallbackValue=False}">
                                <TextBlock Classes="field-label" Text="Sign a new certificate with this CA" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Server certificate"
                                            Command="{Binding IssueCommand}"
                                            CommandParameter="{x:Static certs:CertificateKind.Server}"
                                            ToolTip.Tip="For a broker: the certificate it shows to clients" />
                                    <Button Content="Client certificate"
                                            Command="{Binding IssueCommand}"
                                            CommandParameter="{x:Static certs:CertificateKind.Client}"
                                            ToolTip.Tip="For an MQTT client to prove who it is to a broker that asks (mutual TLS)" />
                                    <Button Content="Intermediate CA"
                                            Command="{Binding IssueCommand}"
                                            CommandParameter="{x:Static certs:CertificateKind.IntermediateAuthority}"
                                            ToolTip.Tip="A CA signed by this one, which can sign certificates of its own" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="field-label" Text="Name in the list" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding RenameText}" />
                                    <Button Grid.Column="1" Content="Rename" Command="{Binding RenameCommand}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="Subject" />
                                        <SelectableTextBlock Grid.Column="1" Classes="info-value" TextWrapping="Wrap" Text="{Binding Selected.Subject}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="Signed by" />
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <TextBlock Classes="table-cell" Text="{Binding Selected.IssuerName}" />
                                            <SelectableTextBlock FontSize="{DynamicResource SecondaryFontSize}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding Selected.IssuerSubject}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="Valid" />
                                        <TextBlock Grid.Column="1" Classes="info-value">
                                            <Run Text="{Binding Selected.ValidFrom}" />
                                            <Run Text="to" Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="{Binding Selected.ValidUntil}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="Used for" />
                                        <TextBlock Grid.Column="1" Classes="info-value" Text="{Binding Selected.Usage}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row" IsVisible="{Binding !Selected.IsAuthority, FallbackValue=False}">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="Alternative names" />
                                        <SelectableTextBlock Grid.Column="1" Classes="info-value" TextWrapping="Wrap" Text="{Binding Selected.AlternativeNames}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="Key" />
                                        <TextBlock Grid.Column="1" Classes="info-value" Text="{Binding Selected.KeyText}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="Serial number" />
                                        <SelectableTextBlock Grid.Column="1" Classes="info-value code" Text="{Binding Selected.SerialNumber}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="SHA-256 fingerprint" />
                                        <SelectableTextBlock Grid.Column="1" Classes="info-value code" TextWrapping="Wrap" Text="{Binding Selected.Fingerprint}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="Used by" />
                                        <TextBlock Grid.Column="1" Classes="info-value" TextWrapping="Wrap" Text="{Binding Selected.UsedBy}"
                                                   ToolTip.Tip="MQTT clients whose TLS settings use one of its files" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Files -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="card-title" Text="Files" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="small" Content="Open folder" Click="OnOpenFolderClick" />
                                </Grid>
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="Certificate" />
                                    <TextBox Classes="code" IsReadOnly="True" Text="{Binding Selected.CertificatePath, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="Private key (not encrypted)" />
                                    <TextBox Classes="code" IsReadOnly="True" Text="{Binding Selected.KeyPath, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding Selected.IsNotRoot, FallbackValue=False}">
                                    <TextBlock Classes="field-label" Text="Certificate and intermediate CAs, for a broker's certfile" />
                                    <TextBox Classes="code" IsReadOnly="True" Text="{Binding Selected.ChainPath, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="CA certificates to trust it by, for a cafile" />
                                    <TextBox Classes="code" IsReadOnly="True" Text="{Binding Selected.AuthorityPath, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="info-label" TextWrapping="Wrap">
                        <Run Text="Each certificate is made in the folder chosen for it; the list is kept in" />
                        <Run FontFamily="{DynamicResource CodeFontFamily}" Text="{Binding IndexPath, Mode=OneWay}" />
                        <Run Text=". Private keys are stored unencrypted; on Linux and macOS only you can read them. " />
                        <Run Text="Anyone with a CA's key can make certificates that clients and brokers trusting the CA accept. " />
                        <Run Text="What a new certificate is filled in with is set on Settings / Certificate Defaults." />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>

</UserControl>
