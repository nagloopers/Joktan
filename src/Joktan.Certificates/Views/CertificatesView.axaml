<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Certificates.Resources"
             xmlns:vm="using:Joktan.Certificates.ViewModels"
             xmlns:certs="using:Joktan.Certificates"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="900"
             x:Class="Joktan.Certificates.Views.CertificatesView"
             x:DataType="vm:CertificatesViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" Text="{Binding Title}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="accent"
                        Content="{x:Static res:Strings.CertificatesView_NewRootCA}"
                        VerticalAlignment="Center"
                        Command="{Binding NewAuthorityCommand}"
                        ToolTip.Tip="{x:Static res:Strings.CertificatesView_MakeACertificateAuthorityThatSigns}" />
            </Grid>
        </Border>

        <!-- What happened last -->
        <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0" Spacing="4"
                    IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding Message}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Classes="error" Margin="24,8,24,0" TextWrapping="Wrap"
                   Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Grid Margin="24,16,24,24" ColumnDefinitions="2*,16,3*">

            <!-- Authorities and what they signed -->
            <Border Classes="card" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,8,12,8">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.CertificatesView_AuthoritiesAndCertificates}" />
                        <TextBlock Classes="card-subtitle" Margin="0,6,0,0"
                                   Text="{x:Static res:Strings.CertificatesView_EachCertificateSitsBelowTheCA}" />
                    </StackPanel>
                    <Panel>
                        <TextBlock Classes="info-label"
                                   Margin="12"
                                   TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.CertificatesView_NoCertificatesYetStartWithNew}"
                                   IsVisible="{Binding IsEmpty}" />
                        <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected}">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem" x:DataType="vm:CertificateNodeViewModel">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                                <!-- Muted text is too faint on the selection colour -->
                                <Style Selector="TreeViewItem:selected TextBlock.info-label">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="vm:CertificateNodeViewModel" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding StatusText}">
                                        <Ellipse Classes="state-dot"
                                                 Classes.ok="{Binding IsValid}"
                                                 Classes.pending="{Binding IsExpiring}"
                                                 Classes.failed="{Binding IsExpired}" />
                                        <TextBlock Classes="table-cell" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Classes="info-label" VerticalAlignment="Center" Text="{Binding Summary}" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Panel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2">
                <StackPanel Spacing="16">

                    <Border Classes="card" IsVisible="{Binding !HasSelection}">
                        <TextBlock Classes="info-label" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.CertificatesView_SelectACAOrCertificateTo}" />
                    </Border>

                    <!-- Selected certificate -->
                    <Border Classes="card" IsVisible="{Binding HasSelection}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="card-title" FontSize="{DynamicResource SectionTitleFontSize}" Text="{Binding Selected.Name}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                        <Ellipse Classes="state-dot"
                                                 Classes.ok="{Binding Selected.IsValid}"
                                                 Classes.pending="{Binding Selected.IsExpiring}"
                                                 Classes.failed="{Binding Selected.IsExpired}" />
                                        <TextBlock Classes="info-label" VerticalAlignment="Center">
                                            <Run Text="{Binding Selected.KindText}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding Selected.StatusText}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                    <Button Content="{x:Static res:Strings.CertificatesView_Export}" Command="{Binding ExportCommand}"
                                            ToolTip.Tip="{x:Static res:Strings.CertificatesView_WriteTheCertificateAndItsKey}" />
                                    <Button Content="{x:Static res:Strings.CertificatesView_Delete}" Command="{Binding DeleteCommand}"
                                            ToolTip.Tip="{x:Static res:Strings.CertificatesView_DeleteItAndEverythingItSigned}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Classes="error" TextWrapping="Wrap"
                                       Text="{Binding Selected.Problem}"
                                       IsVisible="{Binding Selected.HasProblem, FallbackValue=False}" />

                            <!-- Delete, once confirmed -->
                            <Border Classes="group-row" Padding="12" IsVisible="{Binding IsConfirmingDelete}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Classes="table-cell" TextWrapping="Wrap" Text="{Binding DeleteText}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="{x:Static res:Strings.CertificatesView_Cancel}" Command="{Binding CancelDeleteCommand}" />
                                        <Button Classes="accent" Content="{x:Static res:Strings.CertificatesView_Delete}" Command="{Binding ConfirmDeleteCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Sign more with a CA -->
                            <StackPanel Spacing="8" IsVisible="{Binding Selected.IsAuthority, FallbackValue=False}">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificatesView_SignANewCertificateWithThis}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{x:Static res:Strings.CertificatesView_ServerCertificate}"
                                            Command="{Binding IssueCommand}"
                                            CommandParameter="{x:Static certs:CertificateKind.Server}"
                                            ToolTip.Tip="{x:Static res:Strings.CertificatesView_ForABrokerTheCertificateIt}" />
                                    <Button Content="{x:Static res:Strings.CertificatesView_ClientCertificate}"
                                            Command="{Binding IssueCommand}"
                                            CommandParameter="{x:Static certs:CertificateKind.Client}"
                                            ToolTip.Tip="{x:Static res:Strings.CertificatesView_ForAnMQTTClientToProve}" />
                                    <Button Content="{x:Static res:Strings.CertificatesView_IntermediateCA}"
                                            Command="{Binding IssueCommand}"
                                            CommandParameter="{x:Static certs:CertificateKind.IntermediateAuthority}"
                                            ToolTip.Tip="{x:Static res:Strings.CertificatesView_ACASignedByThisOne}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificatesView_NameInTheList}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding RenameText}" />
                                    <Button Grid.Column="1" Content="{x:Static res:Strings.CertificatesView_Rename}" Command="{Binding RenameCommand}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.CertificatesView_Subject}" />
                                        <SelectableTextBlock Grid.Column="1" Classes="info-value" TextWrapping="Wrap" Text="{Binding Selected.Subject}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.CertificatesView_SignedBy}" />
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <TextBlock Classes="table-cell" Text="{Binding Selected.IssuerName}" />
                                            <SelectableTextBlock FontSize="{DynamicResource SecondaryFontSize}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding Selected.IssuerSubject}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.CertificatesView_Valid}" />
                                        <TextBlock Grid.Column="1" Classes="info-value">
                                            <Run Text="{Binding Selected.ValidFrom}" />
                                            <Run Text="{x:Static res:Strings.CertificatesView_To}" Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="{Binding Selected.ValidUntil}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.CertificatesView_UsedFor}" />
                                        <TextBlock Grid.Column="1" Classes="info-value" Text="{Binding Selected.Usage}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row" IsVisible="{Binding !Selected.IsAuthority, FallbackValue=False}">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.CertificatesView_AlternativeNames}" />
                                        <SelectableTextBlock Grid.Column="1" Classes="info-value" TextWrapping="Wrap" Text="{Binding Selected.AlternativeNames}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.CertificatesView_Key}" />
                                        <TextBlock Grid.Column="1" Classes="info-value" Text="{Binding Selected.KeyText}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.CertificatesView_SerialNumber}" />
                                        <SelectableTextBlock Grid.Column="1" Classes="info-value code" Text="{Binding Selected.SerialNumber}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.CertificatesView_SHA256Fingerprint}" />
                                        <SelectableTextBlock Grid.Column="1" Classes="info-value code" TextWrapping="Wrap" Text="{Binding Selected.Fingerprint}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.CertificatesView_UsedBy}" />
                                        <TextBlock Grid.Column="1" Classes="info-value" TextWrapping="Wrap" Text="{Binding Selected.UsedBy}"
                                                   ToolTip.Tip="{x:Static res:Strings.CertificatesView_MQTTClientsWhoseTLSSettingsUse}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Files -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="card-title" Text="{x:Static res:Strings.CertificatesView_Files}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.CertificatesView_OpenFolder}" Click="OnOpenFolderClick" />
                                </Grid>
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificatesView_Certificate}" />
                                    <TextBox Classes="code" IsReadOnly="True" Text="{Binding Selected.CertificatePath, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificatesView_PrivateKeyNotEncrypted}" />
                                    <TextBox Classes="code" IsReadOnly="True" Text="{Binding Selected.KeyPath, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding Selected.IsNotRoot, FallbackValue=False}">
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificatesView_CertificateAndIntermediateCAsForA}" />
                                    <TextBox Classes="code" IsReadOnly="True" Text="{Binding Selected.ChainPath, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificatesView_CACertificatesToTrustItBy}" />
                                    <TextBox Classes="code" IsReadOnly="True" Text="{Binding Selected.AuthorityPath, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="info-label" TextWrapping="Wrap">
                        <Run Text="{x:Static res:Strings.CertificatesView_EachCertificateIsMadeInThe}" />
                        <Run FontFamily="{DynamicResource CodeFontFamily}" Text="{Binding IndexPath, Mode=OneWay}" />
                        <Run Text="{x:Static res:Strings.CertificatesView_PrivateKeysAreStoredUnencryptedOn}" />
                        <Run Text="{x:Static res:Strings.CertificatesView_AnyoneWithACASKey}" />
                        <Run Text="{x:Static res:Strings.CertificatesView_WhatANewCertificateIsFilled}" />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>

</UserControl>
