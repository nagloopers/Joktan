<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Certificates.Resources"
             xmlns:vm="using:Joktan.Certificates.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="736"
             x:Class="Joktan.Certificates.Views.CertificateDefaultsView"
             x:DataType="vm:CertificateDefaultsViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="card-title" Text="{x:Static res:Strings.CertificateDefaultsView_Defaults}" />
                                <TextBlock Classes="card-subtitle" TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.CertificateDefaultsView_WhatANewCertificateIsFilled}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.CertificateDefaultsView_Reset}" VerticalAlignment="Top" Margin="16,0,0,0"
                                    Command="{Binding ResetCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.CertificateDefaultsView_GoBackToTheBuiltIn}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_RootCACommonName}" />
                                <TextBox Text="{Binding RootCommonName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_IntermediateCACommonName}" />
                                <TextBox Text="{Binding IntermediateCommonName}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_ServerCommonName}" />
                                <TextBox Text="{Binding ServerCommonName}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_ClientCommonName}" />
                                <TextBox Text="{Binding ClientCommonName}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_ServerHostNamesAndIPAddresses}" />
                                <TextBox Text="{Binding ServerAlternativeNames}" PlaceholderText="localhost, 127.0.0.1, ::1" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="12">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_OrganisationO}" />
                                <TextBox Text="{Binding Organization}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_OrganisationalUnitOU}" />
                                <TextBox Text="{Binding OrganizationalUnit}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_LocalityL}" />
                                <TextBox Text="{Binding Locality}" />
                            </StackPanel>
                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,90" ColumnSpacing="16">
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_StateOrProvinceST}" />
                                    <TextBox Text="{Binding State}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_CountryC}" />
                                    <TextBox Text="{Binding Country}" MaxLength="2" PlaceholderText="ZA" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_Key}" />
                                <ComboBox ItemsSource="{Binding KeyAlgorithms}" SelectedItem="{Binding SelectedKeyAlgorithm}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_CAsValidForDays}" />
                                <TextBox Text="{Binding AuthorityValidityDays}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_CertificatesValidForDays}" />
                                <TextBox Text="{Binding CertificateValidityDays}"
                                         ToolTip.Tip="{x:Static res:Strings.CertificateDefaultsView_AppleSSystemsRefuseTLSServer}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.CertificateDefaultsView_FolderForMQTTClientsCertificates}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Classes="code" Text="{Binding ClientFolder}" PlaceholderText="{Binding DefaultClientFolder}" />
                                <Button Grid.Column="1" Content="{x:Static res:Strings.CertificateDefaultsView_Browse}" Command="{Binding BrowseClientFolderCommand}" />
                            </Grid>
                            <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.CertificateDefaultsView_ACAOrClientCertificatePicked}" />
                        </StackPanel>

                        <TextBlock Classes="error" TextWrapping="Wrap"
                                   Text="{Binding Error}"
                                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
