<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Resources"
             x:Class="Joktan.App"
             xmlns:local="using:Joktan"
             Name="Joktan"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. The chosen theme sets it at start-up. -->

    <!-- The application menu on macOS. Name above is what that menu and its items are titled with. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{x:Static res:Strings.App_AboutJoktan}" Click="OnAboutClick" />
            <NativeMenuItem Header="{x:Static res:Strings.App_JoktanHelp}" Click="OnHelpClick" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Joktan.Core/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="avares://Joktan.Core/Styles/Shell.axaml" />
        <StyleInclude Source="avares://Joktan.Core/Styles/Markdown.axaml" />
    </Application.Styles>
</Application>
