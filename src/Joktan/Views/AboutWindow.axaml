<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Joktan.Resources"
        x:Class="Joktan.Views.AboutWindow"
        Icon="avares://Joktan.Core/Assets/joktan.ico"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Title="{x:Static res:Strings.AboutWindow_AboutJoktan}">

    <StackPanel Margin="32" Spacing="8" HorizontalAlignment="Center">
        <Image Source="avares://Joktan.Core/Assets/joktan-icon.png" Width="96" Height="96" Margin="0,0,0,8" />
        <TextBlock Classes="page-title" HorizontalAlignment="Center" Text="Joktan" />
        <TextBlock Name="VersionText" Classes="page-subtitle" HorizontalAlignment="Center" Margin="0" />
        <TextBlock Classes="info-label"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Text="{x:Static res:Strings.AboutWindow_ACrossPlatformAdminApplicationBuilt}" />
        <TextBlock Classes="info-label" HorizontalAlignment="Center" Text="{x:Static res:Strings.AboutWindow_ReleasedUnderTheMITLicence}" />
        <Button Content="{x:Static res:Strings.AboutWindow_Close}" HorizontalAlignment="Center" Margin="0,16,0,0" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
    </StackPanel>

</Window>
