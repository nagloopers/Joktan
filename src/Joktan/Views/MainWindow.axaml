<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Joktan.ViewModels"
        xmlns:core="using:Joktan.Core"
        xmlns:nav="using:Joktan.Core.ViewModels"
        xmlns:help="using:Joktan.Core.Controls"
        xmlns:inbox="using:Joktan.Mqtt.Views"
        xmlns:agent="using:Joktan.Agent.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Joktan.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://Joktan.Core/Assets/joktan.ico"
        Width="1280" Height="800"
        MinWidth="720" MinHeight="480"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Title="Joktan">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*">

        <!-- Sidebar -->
        <Border Name="Sidebar"
                Classes="sidebar"
                Width="{StaticResource SidebarWidth}"
                IsVisible="{Binding IsSidebarOpen}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="brand" Text="joktan" />

                <TextBlock DockPanel.Dock="Top" Classes="sidebar-caption" Text="MAIN MENU" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="nav:NavItemViewModel">
                                <StackPanel IsVisible="{Binding IsInMenu}">
                                    <Button Classes="nav-item"
                                            Classes.selected="{Binding IsSelected}"
                                            Command="{Binding #Sidebar.((vm:MainViewModel)DataContext).NavigateCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <PathIcon Data="{Binding Icon}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="14,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Title}" />
                                            <PathIcon Grid.Column="2"
                                                      Classes="chevron"
                                                      Data="{x:Static core:Icons.ChevronDown}"
                                                      IsVisible="{Binding HasChildren}" />
                                        </Grid>
                                    </Button>

                                    <Border Classes="nav-children" IsVisible="{Binding IsExpanded}">
                                        <ItemsControl ItemsSource="{Binding Children}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="nav:NavItemViewModel">
                                                    <StackPanel IsVisible="{Binding IsInMenu}">
                                                        <Button Classes="nav-subitem"
                                                                Classes.selected="{Binding IsSelected}"
                                                                Command="{Binding #Sidebar.((vm:MainViewModel)DataContext).NavigateCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                                                                <PathIcon Grid.Column="1"
                                                                          Classes="chevron"
                                                                          Data="{x:Static core:Icons.ChevronDown}"
                                                                          IsVisible="{Binding HasChildren}" />
                                                            </Grid>
                                                        </Button>

                                                        <!-- Third level -->
                                                        <Border Classes="nav-children" IsVisible="{Binding IsExpanded}">
                                                            <ItemsControl ItemsSource="{Binding Children}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="nav:NavItemViewModel">
                                                                        <Button Classes="nav-subitem"
                                                                                IsVisible="{Binding IsInMenu}"
                                                                                Classes.selected="{Binding IsSelected}"
                                                                                Command="{Binding #Sidebar.((vm:MainViewModel)DataContext).NavigateCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="{Binding Title}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">

            <!-- Top bar -->
            <!-- Also the window's title bar: drag it to move the window, double-click to maximise -->
            <Border DockPanel.Dock="Top"
                    Name="TopBar"
                    Classes="topbar"
                    Height="{StaticResource TopBarHeight}"
                    PointerPressed="OnTopBarPointerPressed">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Button Classes="icon-button"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="Toggle menu">
                        <PathIcon Data="{x:Static core:Icons.Menu}" />
                    </Button>

                    <!-- The help icon stays right beside the search box, however wide the window is -->
                    <Grid Grid.Column="1"
                          Margin="24,0,40,0"
                          MaxWidth="804"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <TextBox Name="SearchBox"
                                 VerticalAlignment="Center"
                                 Text="{Binding Search.Text}"
                                 PlaceholderText="{Binding Search.Placeholder}">
                            <TextBox.InnerRightContent>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,0">
                                    <Button Name="ClearSearchButton"
                                            Classes="icon-button tab-button"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Clear the search"
                                            IsVisible="{Binding Search.HasText}"
                                            Click="OnClearSearchClick">
                                        <PathIcon Data="{x:Static core:Icons.WindowClose}"
                                                  Width="12" Height="12"
                                                  Foreground="{DynamicResource TextMutedBrush}" />
                                    </Button>
                                    <PathIcon Data="{x:Static core:Icons.Search}"
                                              Width="16" Height="16"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <help:HelpButton Grid.Column="1"
                                         Classes="icon-button"
                                         VerticalAlignment="Center"
                                         ToolTip.Tip="{Binding HelpTip}">
                            <PathIcon Data="{x:Static core:Icons.Help}" />
                        </help:HelpButton>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button Name="AgentButton" Classes="icon-button" VerticalAlignment="Center"
                                ToolTip.Tip="Agent" Command="{Binding Agent.ToggleCommand}">
                            <PathIcon Data="{x:Static core:Icons.Agent}" />
                        </Button>
                        <Panel VerticalAlignment="Center">
                            <Button Name="MessagesButton" Classes="icon-button" ToolTip.Tip="{Binding Inbox.MessagesTip}">
                                <PathIcon Data="{x:Static core:Icons.Message}" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight" Opened="OnMessagesOpened" Closed="OnMessagesClosed">
                                        <inbox:InboxMessagesPanel DataContext="{Binding Inbox}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Ellipse Classes="badge" IsVisible="{Binding Inbox.HasUnreadMessages}" />
                        </Panel>
                        <Panel VerticalAlignment="Center">
                            <Button Name="AlertsButton" Classes="icon-button" ToolTip.Tip="{Binding Inbox.AlertsTip}">
                                <PathIcon Data="{x:Static core:Icons.Bell}" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight" Opened="OnAlertsOpened" Closed="OnAlertsClosed">
                                        <inbox:InboxAlertsPanel DataContext="{Binding Inbox}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Ellipse Classes="badge"
                                     Classes.warning="{Binding Inbox.IsUnreadWarning}"
                                     Classes.info="{Binding Inbox.IsUnreadInfo}"
                                     IsVisible="{Binding Inbox.HasUnreadAlerts}" />
                        </Panel>
                    </StackPanel>

                    <!-- Window controls, in place of the system title bar -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="20,0,0,0">
                        <Button Classes="window-button" ToolTip.Tip="Minimise" Click="OnMinimizeClick">
                            <PathIcon Data="{x:Static core:Icons.WindowMinimize}" />
                        </Button>
                        <Button Classes="window-button" ToolTip.Tip="Maximise" Name="MaximizeButton" Click="OnMaximizeClick">
                            <PathIcon Name="MaximizeIcon" Data="{x:Static core:Icons.WindowMaximize}" />
                        </Button>
                        <Button Classes="window-button close" ToolTip.Tip="Close" Click="OnCloseClick">
                            <PathIcon Data="{x:Static core:Icons.WindowClose}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page content, resolved to a view by ViewLocator, and the docked agent panel beside it -->
            <Grid Name="ContentGrid" ColumnDefinitions="*,Auto,Auto">
                <ContentControl MinWidth="320" Content="{Binding CurrentPage}" />
                <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" Background="{DynamicResource BorderBrush}"
                              IsVisible="{Binding Agent.IsDocked}" />
                <agent:AgentPanel Grid.Column="2" DataContext="{Binding Agent}" IsVisible="{Binding IsDocked}" />
            </Grid>
        </DockPanel>

        <!-- Outside the top bar, whose handler would otherwise take presses in the results for moving the window -->
        <Popup Name="SearchResults"
               PlacementTarget="{Binding #SearchBox}"
               Placement="BottomEdgeAlignedLeft"
               IsLightDismissEnabled="True"
               OverlayDismissEventPassThrough="True"
               WindowManagerAddShadowHint="False"
               IsOpen="{Binding Search.IsOpen, Mode=TwoWay}">
            <Border Width="{Binding #SearchBox.Bounds.Width}"
                    MaxHeight="480"
                    Margin="0,4,0,0"
                    Padding="4"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Panel>
                    <TextBlock Classes="info-label" Margin="12"
                               Text="Nothing found."
                               IsVisible="{Binding Search.HasNoMatches}" />
                    <StackPanel Margin="12" Spacing="8" IsVisible="{Binding Search.IsAllOff}">
                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="Every area of search is switched off." />
                        <Button Classes="small" Content="Choose what to search" Command="{Binding Search.ShowSettingsCommand}" />
                    </StackPanel>
                    <ListBox Name="SearchResultList"
                             Background="Transparent"
                             ItemsSource="{Binding Search.Results}"
                             SelectedItem="{Binding Search.Highlighted}"
                             Tapped="OnSearchResultTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:SearchHit">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock TextTrimming="CharacterEllipsis"
                                                   help:TextHighlight.Source="{Binding Title}"
                                                   help:TextHighlight.Words="{Binding #SearchResultList.((vm:MainViewModel)DataContext).Search.Words}" />
                                        <TextBlock Grid.Column="1" Classes="info-label" VerticalAlignment="Center" Text="{Binding Area}" />
                                    </Grid>
                                    <TextBlock Classes="info-label" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               help:TextHighlight.Source="{Binding Text}"
                                               help:TextHighlight.Words="{Binding #SearchResultList.((vm:MainViewModel)DataContext).Search.Words}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>
            </Border>
        </Popup>
    </Grid>

</Window>
