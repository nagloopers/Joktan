<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Passwords.Resources"
             xmlns:vm="using:Joktan.Passwords.ViewModels"
             xmlns:core="using:Joktan.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="Joktan.Passwords.Views.PasswordsView"
             x:DataType="vm:PasswordsViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" Text="{Binding Title}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding IsOpen}">
                    <Button Content="{x:Static res:Strings.PasswordsView_Storage}" Command="{Binding ToggleStorageCommand}"
                            ToolTip.Tip="{x:Static res:Strings.PasswordsView_WhereThePasswordsAreKeptWhen}" />
                    <Button Content="{x:Static res:Strings.PasswordsView_Lock}" Command="{Binding LockCommand}" IsVisible="{Binding IsVault}"
                            ToolTip.Tip="{x:Static res:Strings.PasswordsView_CloseTheVaultTheMasterPassword}" />
                    <Button Content="{x:Static res:Strings.PasswordsView_NewFolder}" Command="{Binding NewFolderCommand}"
                            ToolTip.Tip="{x:Static res:Strings.PasswordsView_AddAFolderInTheSelected}" />
                    <Button Classes="accent" Content="{x:Static res:Strings.PasswordsView_NewEntry}" Command="{Binding NewEntryCommand}"
                            ToolTip.Tip="{x:Static res:Strings.PasswordsView_AddALoginInTheSelected}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Storage, locking and the master password -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="24,16,24,0">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsOpen" />
                    <Binding Path="IsChangingStorage" />
                </MultiBinding>
            </Border.IsVisible>
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel>
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.PasswordsView_Storage}" />
                        <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding StorageText, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run FontFamily="{DynamicResource CodeFontFamily}" Text="{Binding StorageLocation, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" IsVisible="{Binding IsVault}">
                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.PasswordsView_LockTheVaultWhenUnused}" />
                        <ComboBox ItemsSource="{Binding LockChoices}" SelectedItem="{Binding SelectedLockChoice}" Width="200" />
                    </StackPanel>
                </Grid>

                <!-- Move the entries -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.PasswordsView_MoveTheEntriesTo}" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton GroupName="target" Content="{x:Static res:Strings.PasswordsView_AVaultFile}" IsChecked="{Binding TargetIsVault}" />
                        <RadioButton GroupName="target" IsChecked="{Binding TargetIsKeychain}"
                                     IsEnabled="{Binding IsKeychainAvailable}"
                                     Content="{x:Static vm:PasswordsViewModel.KeychainName}" />
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding TargetIsVault}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Classes="code" Text="{Binding TargetVaultPath}" />
                            <Button Grid.Column="1" Content="{x:Static res:Strings.PasswordsView_Browse}" Command="{Binding BrowseVaultCommand}" />
                        </Grid>
                        <TextBlock Classes="field-label" Text="{Binding TargetPasswordLabel}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <TextBox PasswordChar="•" Text="{Binding TargetMasterPassword}" PlaceholderText="{x:Static res:Strings.PasswordsView_MasterPassword}" />
                            <TextBox Grid.Column="1" PasswordChar="•" Text="{Binding TargetRepeatPassword}"
                                     PlaceholderText="{x:Static res:Strings.PasswordsView_RepeatIt}" IsVisible="{Binding !TargetVaultExists}" />
                        </Grid>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <TextBlock Classes="info-label" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="{x:Static res:Strings.PasswordsView_EveryEntryIsCopiedThereThen}" />
                        <Button Grid.Column="1" Classes="accent" Content="{x:Static res:Strings.PasswordsView_MoveEntries}" Command="{Binding MoveStorageCommand}" />
                    </Grid>
                </StackPanel>

                <!-- Change the master password -->
                <StackPanel Spacing="8" IsVisible="{Binding IsVault}">
                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.PasswordsView_ChangeTheMasterPassword}" />
                    <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8">
                        <TextBox PasswordChar="•" Text="{Binding CurrentMasterPassword}" PlaceholderText="{x:Static res:Strings.PasswordsView_CurrentMasterPassword}" />
                        <TextBox Grid.Column="1" PasswordChar="•" Text="{Binding TargetMasterPassword}" PlaceholderText="{x:Static res:Strings.PasswordsView_NewMasterPassword}" />
                        <TextBox Grid.Column="2" PasswordChar="•" Text="{Binding TargetRepeatPassword}" PlaceholderText="{x:Static res:Strings.PasswordsView_RepeatIt}" />
                        <Button Grid.Column="3" Content="{x:Static res:Strings.PasswordsView_Change}" Command="{Binding ChangeMasterPasswordCommand}" />
                    </Grid>
                </StackPanel>

                <Button HorizontalAlignment="Right" Content="{x:Static res:Strings.PasswordsView_Close}" Command="{Binding ToggleStorageCommand}" />
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Classes="error" Margin="24,12,24,0" TextWrapping="Wrap"
                   Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock DockPanel.Dock="Top" Classes="info-label" Margin="24,12,24,0" TextWrapping="Wrap"
                   Text="{Binding Message}"
                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Panel Margin="24">

            <!-- Choosing where the passwords are kept -->
            <Border Classes="card" IsVisible="{Binding IsSetup}" MaxWidth="640" VerticalAlignment="Top">
                <StackPanel Spacing="16">
                    <StackPanel>
                        <TextBlock Classes="card-title" FontSize="{DynamicResource SectionTitleFontSize}" Text="{x:Static res:Strings.PasswordsView_WhereShouldYourPasswordsBeKept}" />
                        <TextBlock Classes="card-subtitle"
                                   Text="{x:Static res:Strings.PasswordsView_ForAnyPasswordYouWantTo}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <RadioButton GroupName="setup" IsChecked="{Binding SetupIsVault}" FontWeight="SemiBold"
                                     Content="{x:Static res:Strings.PasswordsView_AnEncryptedVaultFile}" />
                        <TextBlock Classes="info-label" Margin="28,0,0,0" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.PasswordsView_OneFileEncryptedWithAES256}" />
                        <StackPanel Margin="28,4,0,0" Spacing="8" IsVisible="{Binding SetupIsVault}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Classes="code" Text="{Binding SetupVaultPath}" />
                                <Button Grid.Column="1" Content="{x:Static res:Strings.PasswordsView_Browse}" Command="{Binding BrowseVaultCommand}" />
                            </Grid>
                            <TextBlock Classes="info-label" TextWrapping="Wrap" IsVisible="{Binding SetupVaultExists}"
                                       Text="{x:Static res:Strings.PasswordsView_AVaultIsAlreadyThereIt}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding !SetupVaultExists}">
                                <TextBox PasswordChar="•" Text="{Binding NewMasterPassword}" PlaceholderText="{x:Static res:Strings.PasswordsView_MasterPasswordAtLeast8Characters}" />
                                <TextBox Grid.Column="1" PasswordChar="•" Text="{Binding RepeatMasterPassword}" PlaceholderText="{x:Static res:Strings.PasswordsView_RepeatIt}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <RadioButton GroupName="setup" IsChecked="{Binding SetupIsKeychain}" FontWeight="SemiBold"
                                     IsEnabled="{Binding IsKeychainAvailable}"
                                     Content="{x:Static vm:PasswordsViewModel.KeychainName}" />
                        <TextBlock Classes="info-label" Margin="28,0,0,0" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.PasswordsView_EachPasswordIsKeptByThe}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{x:Static res:Strings.PasswordsView_Back}" Command="{Binding LeaveSetupCommand}" IsVisible="{Binding CanLeaveSetup}" />
                        <Button Classes="accent" Content="{Binding SetupButtonText}" Command="{Binding SetupCommand}" IsDefault="{Binding IsSetup}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- A locked vault -->
            <Border Classes="card" IsVisible="{Binding IsLocked}" MaxWidth="480" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <TextBlock Classes="card-title" FontSize="{DynamicResource SectionTitleFontSize}" Text="{x:Static res:Strings.PasswordsView_TheVaultIsLocked}" />
                    <TextBlock Classes="info-label" TextWrapping="Wrap">
                        <Run Text="{x:Static res:Strings.PasswordsView_EnterTheMasterPasswordOf}" />
                        <Run FontFamily="{DynamicResource CodeFontFamily}" Text="{Binding StorageLocation, Mode=OneWay}" />
                    </TextBlock>
                    <TextBox x:Name="UnlockBox" PasswordChar="•" Text="{Binding UnlockPassword}" PlaceholderText="{x:Static res:Strings.PasswordsView_MasterPassword}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Classes="small" Content="{x:Static res:Strings.PasswordsView_UseAnotherVaultOrTheKeychain}" VerticalAlignment="Center"
                                Command="{Binding ChooseStorageCommand}" />
                        <Button Grid.Column="1" Classes="accent" Content="{x:Static res:Strings.PasswordsView_Unlock}" Command="{Binding UnlockCommand}" IsDefault="{Binding IsLocked}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The entries -->
            <Grid ColumnDefinitions="300,16,*" IsVisible="{Binding IsOpen}">
                <Border Classes="card" Padding="8">
                    <DockPanel>
                        <TextBox DockPanel.Dock="Top" Margin="8,8,8,8" Text="{Binding SearchText}" PlaceholderText="{x:Static res:Strings.PasswordsView_SearchTitlesUsernamesWebsitesAndNotes}" />
                        <Panel>
                            <TextBlock Classes="info-label" Margin="12" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.PasswordsView_NoEntriesYetAddOneWith}">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsEmpty" />
                                        <Binding Path="!IsSearching" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding TreeSelection}" IsVisible="{Binding !IsSearching}">
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem" x:DataType="vm:PasswordNodeViewModel">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                    <Style Selector="TreeViewItem:selected TextBlock.info-label">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </Style>
                                </TreeView.Styles>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate x:DataType="vm:PasswordNodeViewModel" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Classes="node-icon" Data="{x:Static core:Icons.Folder}" IsVisible="{Binding IsFolder}" />
                                            <PathIcon Classes="node-icon" Data="{x:Static core:Icons.Key}" IsVisible="{Binding IsEntry}" />
                                            <TextBlock Classes="table-cell" Text="{Binding Name}" />
                                            <TextBlock Classes="info-label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Detail}" />
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <Panel IsVisible="{Binding IsSearching}">
                                <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding TreeSelection}" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PasswordNodeViewModel">
                                            <StackPanel>
                                                <TextBlock Classes="table-cell" Text="{Binding Name}" />
                                                <TextBlock Classes="info-label" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Detail, Mode=OneWay}" />
                                                    <Run Text="{Binding Path, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Classes="info-label" Margin="12" Text="{x:Static res:Strings.PasswordsView_NothingMatches}"
                                           IsVisible="{Binding HasNoResults}" />
                            </Panel>
                        </Panel>
                    </DockPanel>
                </Border>

                <!-- Nothing selected -->
                <Border Grid.Column="2" Classes="card" VerticalAlignment="Top" IsVisible="{Binding !HasSelection}">
                    <TextBlock Classes="info-label" TextWrapping="Wrap"
                               Text="{x:Static res:Strings.PasswordsView_SelectAnEntryToSeeIt}" />
                </Border>

                <Border Grid.Column="2" Classes="card" IsVisible="{Binding HasSelection}">
                    <ScrollViewer>
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel>
                                    <TextBlock Classes="page-title" TextWrapping="Wrap" Text="{Binding Selected.Name, FallbackValue=''}"
                                               IsVisible="{Binding IsViewing}" />
                                    <TextBlock Classes="page-title" TextWrapping="Wrap" IsVisible="{Binding IsEditing}"
                                               Text="{Binding EditHeading}" />
                                    <TextBlock Classes="info-label" Margin="0,4,0,0" Text="{Binding Selected.Path, FallbackValue=''}"
                                               IsVisible="{Binding Selected.Path, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                    <Button Classes="accent" Content="{x:Static res:Strings.PasswordsView_Edit}" Command="{Binding EditCommand}" IsVisible="{Binding IsViewing}" />
                                    <Button Content="{x:Static res:Strings.PasswordsView_Delete}" Command="{Binding DeleteCommand}" IsVisible="{Binding IsViewing}" />
                                    <Button Content="{x:Static res:Strings.PasswordsView_Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsEditing}" />
                                    <Button Classes="accent" Content="{x:Static res:Strings.PasswordsView_Save}" Command="{Binding SaveCommand}" IsVisible="{Binding IsEditing}" IsDefault="{Binding IsEditing}" />
                                </StackPanel>
                            </Grid>

                            <!-- Delete, once confirmed -->
                            <Border Classes="group-row" Padding="12" IsVisible="{Binding IsConfirmingDelete}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Classes="table-cell" TextWrapping="Wrap" Text="{Binding DeleteText}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="{x:Static res:Strings.PasswordsView_Cancel}" Command="{Binding CancelDeleteCommand}" />
                                        <Button Classes="accent" Content="{x:Static res:Strings.PasswordsView_Delete}" Command="{Binding ConfirmDeleteCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- A folder -->
                            <StackPanel IsVisible="{Binding IsFolderSelected}">
                                <TextBlock Classes="info-label" Text="{Binding FolderSummary}" IsVisible="{Binding IsViewing}" />
                            </StackPanel>

                            <!-- An entry, to read and copy from -->
                            <StackPanel>
                                <StackPanel.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsEntrySelected" />
                                        <Binding Path="IsViewing" />
                                    </MultiBinding>
                                </StackPanel.IsVisible>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.PasswordsView_Username}" VerticalAlignment="Center" />
                                        <SelectableTextBlock Grid.Column="1" Classes="info-value" VerticalAlignment="Center" TextWrapping="Wrap"
                                                             Text="{Binding EntryUsername}" />
                                        <Button Grid.Column="2" Classes="small" Content="{x:Static res:Strings.PasswordsView_Copy}" Command="{Binding CopyUsernameCommand}"
                                                IsEnabled="{Binding HasUsername}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.PasswordsView_Password}" VerticalAlignment="Center" />
                                        <Panel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Classes="info-value code" Text="••••••••••••" IsVisible="{Binding !IsRevealed}" />
                                            <SelectableTextBlock Classes="info-value code" TextWrapping="Wrap" Text="{Binding RevealedPassword}"
                                                                 IsVisible="{Binding IsRevealed}" />
                                        </Panel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                            <Button Classes="small" Content="{x:Static res:Strings.PasswordsView_Show}" Command="{Binding ToggleRevealCommand}" IsVisible="{Binding !IsRevealed}" />
                                            <Button Classes="small" Content="{x:Static res:Strings.PasswordsView_Hide}" Command="{Binding ToggleRevealCommand}" IsVisible="{Binding IsRevealed}" />
                                            <Button Classes="small" Content="{x:Static res:Strings.PasswordsView_Copy}" Command="{Binding CopyPasswordCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.PasswordsView_CopyItTheClipboardIsCleared}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.PasswordsView_Website}" VerticalAlignment="Center" />
                                        <SelectableTextBlock Grid.Column="1" Classes="info-value" VerticalAlignment="Center" TextWrapping="Wrap"
                                                             Text="{Binding EntryUrl}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsEnabled="{Binding HasUrl}">
                                            <Button Classes="small" Content="{x:Static res:Strings.PasswordsView_Open}" Command="{Binding OpenUrlCommand}" />
                                            <Button Classes="small" Content="{x:Static res:Strings.PasswordsView_Copy}" Command="{Binding CopyUrlCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="info-row" IsVisible="{Binding HasNotes}">
                                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                                        <TextBlock Classes="info-label" Text="{x:Static res:Strings.PasswordsView_Notes}" />
                                        <SelectableTextBlock Grid.Column="1" Classes="info-value" TextWrapping="Wrap" Text="{Binding EntryNotes}" />
                                    </Grid>
                                </Border>
                                <Border Classes="info-row">
                                    <TextBlock Classes="info-label" Text="{Binding ModifiedText}" />
                                </Border>
                            </StackPanel>

                            <!-- Editing an entry or folder -->
                            <StackPanel Spacing="12" IsVisible="{Binding IsEditing}">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <StackPanel>
                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.PasswordsView_Name}" IsVisible="{Binding IsFolderSelected}" />
                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.PasswordsView_Title}" IsVisible="{Binding IsEntrySelected}" />
                                        <TextBox Text="{Binding EditTitle}" PlaceholderText="{x:Static res:Strings.PasswordsView_Untitled}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.PasswordsView_Folder}" />
                                        <ComboBox ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding EditFolder}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="12" IsVisible="{Binding IsEntrySelected}">
                                    <StackPanel>
                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.PasswordsView_UsernameOrEmail}" />
                                        <TextBox Text="{Binding EditUsername}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.PasswordsView_Password}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Classes="code" PasswordChar="•" RevealPassword="{Binding ShowEditPassword}" Text="{Binding EditPassword}" />
                                            <ToggleButton Grid.Column="1" Content="{x:Static res:Strings.PasswordsView_Show}" IsChecked="{Binding ShowEditPassword}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                            <Button Classes="small" Content="{x:Static res:Strings.PasswordsView_Generate}" Command="{Binding GenerateCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.PasswordsView_ReplaceThePasswordWithARandom}" />
                                            <TextBlock Classes="info-label" Text="{x:Static res:Strings.PasswordsView_Length}" VerticalAlignment="Center" />
                                            <NumericUpDown Value="{Binding GenerateLength}" Minimum="8" Maximum="128" Increment="1" FormatString="0" Width="110" />
                                            <CheckBox Content="{x:Static res:Strings.PasswordsView_Symbols}" IsChecked="{Binding GenerateSymbols}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.PasswordsView_Website}" />
                                        <TextBox Text="{Binding EditUrl}" PlaceholderText="https://…" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.PasswordsView_Notes}" />
                                        <TextBox Text="{Binding EditNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" VerticalContentAlignment="Top" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Panel>
    </DockPanel>

</UserControl>
