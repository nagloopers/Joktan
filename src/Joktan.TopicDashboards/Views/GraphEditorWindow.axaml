<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Joktan.TopicDashboards.Resources"
        xmlns:help="using:Joktan.Core.Controls"
        xmlns:core="using:Joktan.Core"
        xmlns:vm="using:Joktan.TopicDashboards.ViewModels"
        xmlns:views="using:Joktan.TopicDashboards.Views"
        xmlns:c="using:Joktan.TopicDashboards.Controls"
        xmlns:mqtt="using:Joktan.Mqtt.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="820"
        x:Class="Joktan.TopicDashboards.Views.GraphEditorWindow"
        core:HelpContext.Topic="topic-dashboards"
        x:DataType="vm:GraphEditorViewModel"
        Width="820" Height="820"
        MinWidth="620" MinHeight="500"
        Icon="avares://Joktan.Core/Assets/joktan.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="{Binding WindowTitle}"
        x:Name="Root">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" FontSize="{DynamicResource DialogTitleFontSize}" Text="{Binding WindowTitle}" />
                    <TextBlock Classes="page-subtitle" Text="{x:Static res:Strings.GraphEditorWindow_SubscribeToTopicsChooseTheirNumbers}" />
                </StackPanel>
                <help:HelpButton Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="topbar" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="error"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,16,0"
                           Text="{Binding Error}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static res:Strings.GraphEditorWindow_Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Classes="accent" Content="{Binding SaveText}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">

                <!-- Topics -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Classes="card-title" Text="{x:Static res:Strings.GraphEditorWindow_Topics}" />
                            <TextBlock Classes="card-subtitle" Margin="0" Text="{x:Static res:Strings.GraphEditorWindow_OneGraphCanDrawNumbersFrom}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="200,*,Auto" ColumnSpacing="12">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.GraphEditorWindow_Client}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="mqtt:MqttClientViewModel">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.GraphEditorWindow_Topic}" />
                                <TextBox Classes="code" Text="{Binding NewTopic}" PlaceholderText="{x:Static res:Strings.GraphEditorWindow_PlantLineTelemetryTemperatureOrUse}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding AddTopicCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                            </StackPanel>
                            <Button Grid.Column="2" VerticalAlignment="Bottom" MinWidth="110"
                                    Content="{x:Static res:Strings.GraphEditorWindow_Subscribe}"
                                    Command="{Binding AddTopicCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.GraphEditorWindow_AddTheTopicToThisGraph}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TopicEntries}" IsVisible="{Binding HasTopics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TopicEntryViewModel">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,4">
                                        <ItemsControl ItemsSource="{Binding Levels}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TopicLevelViewModel">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,4,4">
                                                        <Button Classes="small"
                                                                Classes.accent="{Binding IsKey}"
                                                                Content="{Binding Text}"
                                                                Command="{Binding Entry.MakeKeyCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="{x:Static res:Strings.GraphEditorWindow_PressToMakeThisLevelA}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.GraphEditorWindow_Remove}"
                                                Command="{Binding #Root.((vm:GraphEditorViewModel)DataContext).RemoveTopicCommand}"
                                                CommandParameter="{Binding Text}"
                                                ToolTip.Tip="{x:Static res:Strings.GraphEditorWindow_TakeThisTopicAndItsNumbers}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Classes="info-label" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ListenStatus}" />
                            <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.GraphEditorWindow_Connect}"
                                    Command="{Binding SelectedClient.ConnectCommand}"
                                    IsVisible="{Binding SelectedClient.CanEdit, FallbackValue=False}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Graph -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.GraphEditorWindow_Graph}" />
                        <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="12">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.GraphEditorWindow_Name}" />
                                <TextBox Text="{Binding Name}" PlaceholderText="{x:Static res:Strings.GraphEditorWindow_Line1Temperature}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.GraphEditorWindow_Type}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GraphKindChoice">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.GraphEditorWindow_ShowsTheLast}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Spans}" SelectedItem="{Binding SelectedSpan}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SpanChoice">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding KindDescription}" />

                        <!-- Preview -->
                        <Border Height="240" Padding="12" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <views:GraphCardView DataContext="{Binding Preview}" />
                        </Border>

                        <Grid ColumnDefinitions="*,*,Auto,*,*" ColumnSpacing="12">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.GraphEditorWindow_Unit}" />
                                <TextBox Text="{Binding Unit}" PlaceholderText="°C" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.GraphEditorWindow_DecimalPlaces}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding DecimalChoices}" SelectedItem="{Binding SelectedDecimals}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DecimalsChoice">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox Grid.Column="2" VerticalAlignment="Bottom" Content="{x:Static res:Strings.GraphEditorWindow_FixedScale}" IsChecked="{Binding UseFixedScale}"
                                      ToolTip.Tip="{x:Static res:Strings.GraphEditorWindow_KeepTheScaleBetweenTheseNumbers}" />
                            <StackPanel Grid.Column="3" IsVisible="{Binding UseFixedScale}">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.GraphEditorWindow_Minimum}" />
                                <TextBox Text="{Binding MinimumText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" IsVisible="{Binding UseFixedScale}">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.GraphEditorWindow_Maximum}" />
                                <TextBox Text="{Binding MaximumText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Numbers -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <StackPanel>
                            <TextBlock Classes="card-title" Text="{x:Static res:Strings.GraphEditorWindow_NumbersToDraw}" />
                            <TextBlock Classes="card-subtitle" Margin="0" Text="{x:Static res:Strings.GraphEditorWindow_UpTo8OnOneGraph}" />
                        </StackPanel>
                        <TextBlock Classes="info-label" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.GraphEditorWindow_NoNumbersYetTheyAreListed}"
                                   IsVisible="{Binding HasNoNumbers}" />
                        <ItemsControl ItemsSource="{Binding Values}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GraphValueChoiceViewModel">
                                    <StackPanel Margin="0,0,0,6" Spacing="4">
                                    <Grid ColumnDefinitions="3*,50,70,*,130,Auto" ColumnSpacing="10">
                                        <CheckBox IsChecked="{Binding IsChosen}" ToolTip.Tip="{Binding Topic}">
                                            <StackPanel>
                                                <TextBlock Classes="code" TextTrimming="CharacterEllipsis" Text="{Binding DisplayPath}" />
                                                <TextBlock Classes="info-label" FontSize="{DynamicResource TinyFontSize}" TextTrimming="CharacterEllipsis" Text="{Binding Topic}"
                                                           IsVisible="{Binding #Root.((vm:GraphEditorViewModel)DataContext).HasSeveralTopics}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock Grid.Column="1" Classes="info-label" VerticalAlignment="Center" Text="{Binding Kind}" />
                                        <TextBlock Grid.Column="2" Classes="table-cell" VerticalAlignment="Center" Text="{Binding LatestText}" />
                                        <TextBox Grid.Column="3" Text="{Binding Label}" PlaceholderText="{x:Static res:Strings.GraphEditorWindow_Name}" IsEnabled="{Binding IsChosen}" />
                                        <ComboBox Grid.Column="4" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Static vm:GraphEditorViewModel.ColorChoices}"
                                                  SelectedIndex="{Binding Color}"
                                                  IsEnabled="{Binding IsChosen}"
                                                  ToolTip.Tip="{x:Static res:Strings.GraphEditorWindow_TheColourOfThisNumber}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ColorChoice">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <c:ColorDot Slot="{Binding Slot}" />
                                                        <TextBlock Text="{Binding Name}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="5" Classes="small" Content="×" VerticalAlignment="Center"
                                                Command="{Binding RemoveCommand}"
                                                ToolTip.Tip="{x:Static res:Strings.GraphEditorWindow_TakeThisNumberOffTheGraph}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasBetterPath}">
                                        <TextBlock Classes="info-label" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding BetterPathText}" />
                                        <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.GraphEditorWindow_UseIt}" Command="{Binding UseBetterPathCommand}" />
                                    </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,2*,Auto" ColumnSpacing="8" IsVisible="{Binding HasTopics}">
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Topics}" SelectedItem="{Binding ManualTopic}"
                                      ToolTip.Tip="{x:Static res:Strings.GraphEditorWindow_TheTopicTheNumberIsOn}" />
                            <TextBox Grid.Column="1" Classes="code" Text="{Binding ManualPath}" PlaceholderText="{x:Static res:Strings.GraphEditorWindow_AddByPathSuchAsReadings}" />
                            <Button Grid.Column="2" Content="{x:Static res:Strings.GraphEditorWindow_Add}" Command="{Binding AddManualPathCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Keys -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <StackPanel>
                            <TextBlock Classes="card-title" Text="{x:Static res:Strings.GraphEditorWindow_Keys}" />
                            <TextBlock Classes="card-subtitle" Margin="0" TextWrapping="Wrap" Text="{x:Static res:Strings.GraphEditorWindow_WhatTellsTheNumbersApartSuch}" />
                        </StackPanel>
                        <TextBlock Classes="info-label" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.GraphEditorWindow_NoKeysYetPressALevel}"
                                   IsVisible="{Binding !HasKeys}" />
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KeySuggestion">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                        <TextBlock Classes="info-label" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Text}" />
                                        <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.GraphEditorWindow_ShowOneLineForEach}" Command="{Binding AddCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Keys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GraphKeyViewModel">
                                    <Grid ColumnDefinitions="120,*,130,130,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                                        <TextBlock Classes="code" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Field}" />
                                        <TextBlock Grid.Column="1" Classes="info-label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SeenText}" />
                                        <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Static vm:GraphKeyViewModel.Choices}"
                                                  SelectedItem="{Binding SelectedShow}"
                                                  ToolTip.Tip="{x:Static res:Strings.GraphEditorWindow_ShowEachValueAs}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:KeyShowChoice">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="3" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Values}"
                                                  SelectedItem="{Binding OnlyValue}"
                                                  IsVisible="{Binding IsOnly}"
                                                  ToolTip.Tip="{x:Static res:Strings.GraphEditorWindow_TheOneValueToKeep}" />
                                        <Button Grid.Column="4" Classes="small" Content="{x:Static res:Strings.GraphEditorWindow_Remove}" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasFieldChoices}">
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding FieldChoices}" SelectedItem="{Binding SelectedField}"
                                      PlaceholderText="{x:Static res:Strings.GraphEditorWindow_AddAKeyFromTheMessage}" />
                            <Button Grid.Column="1" Content="{x:Static res:Strings.GraphEditorWindow_Add}" Command="{Binding AddKeyCommand}" />
                        </Grid>
                        <StackPanel Spacing="4" IsVisible="{Binding HasLines}">
                            <TextBlock Classes="field-label" Margin="0" Text="{x:Static res:Strings.GraphEditorWindow_LinesOnThisGraph}" />
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GraphLineViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                                            <c:ColorDot Slot="{Binding Slot}" VerticalAlignment="Center" IsVisible="{Binding !IsRemoved}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Classes="info-label" Classes.table-cell="{Binding !IsRemoved}" Text="{Binding Label}" />
                                            <Button Grid.Column="2" Classes="small" Content="×" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}"
                                                    ToolTip.Tip="{x:Static res:Strings.GraphEditorWindow_TakeThisLineOffTheGraph}" />
                                            <Button Grid.Column="2" Classes="small" Content="{x:Static res:Strings.GraphEditorWindow_BringBack}" Command="{Binding BringBackCommand}" IsVisible="{Binding IsRemoved}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Classes="info-label" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding OutcomeText}" IsVisible="{Binding HasOutcome}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasUnitHint}">
                            <TextBlock Classes="info-label" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding UnitHint}" />
                            <Button Grid.Column="1" Classes="small" Content="{x:Static res:Strings.GraphEditorWindow_OneGraphForEach}" Command="{Binding SplitIntoGraphsCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Where it goes -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.GraphEditorWindow_OnTheDashboard}" />
                        <Grid ColumnDefinitions="*,100,100" ColumnSpacing="12">
                            <StackPanel Spacing="8" IsVisible="{Binding CanChooseDashboard}">
                                <TextBlock Classes="field-label" Margin="0" Text="{x:Static res:Strings.GraphEditorWindow_Dashboard}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Dashboards}"
                                          SelectedItem="{Binding SelectedDashboard}"
                                          IsVisible="{Binding !IsNewDashboard}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DashboardTabViewModel">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Text="{Binding NewDashboardName}"
                                         PlaceholderText="{x:Static res:Strings.GraphEditorWindow_NameOfTheNewDashboard}"
                                         IsVisible="{Binding IsNewDashboard}" />
                                <CheckBox Content="{x:Static res:Strings.GraphEditorWindow_PutItOnANewDashboard}" IsChecked="{Binding IsNewDashboard}" />
                                <StackPanel IsVisible="{Binding CanChooseTarget}">
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.GraphEditorWindow_AddThisTopicTo}" />
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                                              ToolTip.Tip="{x:Static res:Strings.GraphEditorWindow_StartANewGraphOrDraw}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GraphTarget">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.GraphEditorWindow_ColumnsWide}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Sizes}" SelectedItem="{Binding WidthSpan}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.GraphEditorWindow_RowsHigh}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Sizes}" SelectedItem="{Binding HeightSpan}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
