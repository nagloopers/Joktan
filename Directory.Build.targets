<Project>
  <!-- Each assembly keeps the text it shows in Resources/Strings.resx. The build makes the Strings class from it. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/Resources/Strings.resx')">
    <EmbeddedResource Update="Resources/Strings.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedNamespace="$(RootNamespace).Resources"
                      StronglyTypedClassName="Strings"
                      StronglyTypedFileName="$(IntermediateOutputPath)Strings.g.cs"
                      PublicClass="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(DesignTimeBuild)' == 'true' And Exists('$(MSBuildProjectDirectory)/Resources/Strings.resx') And Exists('$(IntermediateOutputPath)Strings.g.cs')">
    <Compile Include="$(IntermediateOutputPath)Strings.g.cs" />
  </ItemGroup>
  <Target Name="RemoveDesignTimeStringsBeforeResGen" BeforeTargets="CoreResGen" Condition="'$(DesignTimeBuild)' == 'true'">
    <ItemGroup>
      <Compile Remove="$(IntermediateOutputPath)Strings.g.cs" />
    </ItemGroup>
  </Target>
</Project>
